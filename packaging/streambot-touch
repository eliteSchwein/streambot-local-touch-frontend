#!/bin/bash
set -euo pipefail

MCCONFIGFILE="$HOME/.config/streambot/streambot-touch.cfg"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app-config|--config_path)
            MCCONFIGFILE="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

export STREAMBOT_TOUCH_CONFIG="$MCCONFIGFILE"

# Use Qt Virtual Keyboard directly inside the Quickshell application.
export QT_IM_MODULE=qtvirtualkeyboard

# Custom Material 3 keyboard style shipped with Streambot Touch.
export QT_VIRTUALKEYBOARD_STYLE=md3
export QML2_IMPORT_PATH="/usr/share/streambot-touch${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"

exec /usr/bin/qs --path /usr/share/streambot-touch
