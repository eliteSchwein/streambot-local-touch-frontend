#!/bin/bash
set -euo pipefail

MCCONFIGFILE="$HOME/.config/streambot/streambot-touch.cfg"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app-config|--config_path)
            MCCONFIGFILE="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

export STREAMBOT_TOUCH_CONFIG="$MCCONFIGFILE"

# Use Qt Virtual Keyboard directly inside the Quickshell application.
export QT_IM_MODULE=qtvirtualkeyboard

# Force embedded/application integration. This prevents Qt Wayland from
# attempting unsupported client-side desktop virtual-keyboard integration.
export QT_VIRTUALKEYBOARD_DESKTOP_DISABLE=1

# Keep the custom Material 3 keyboard style disabled until the stock
# Qt Virtual Keyboard is confirmed working.
unset QT_VIRTUALKEYBOARD_STYLE
unset QML2_IMPORT_PATH

exec /usr/bin/qs --path /usr/share/streambot-touch
