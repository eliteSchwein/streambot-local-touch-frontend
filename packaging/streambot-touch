#!/bin/bash
set -euo pipefail

MCCONFIGFILE="$HOME/streambot-touch.cfg"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app-config|--config_path)
            if [[ $# -lt 2 ]]; then
                echo "Missing value for $1" >&2
                exit 1
            fi

            MCCONFIGFILE="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

export STREAMBOT_TOUCH_CONFIG="$MCCONFIGFILE"

exec /usr/bin/qs --path /usr/share/streambot-touch
