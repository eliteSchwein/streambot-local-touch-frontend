import { LineEdit, Slider, Spinner } from "std-widgets.slint";

// Original Quickshell Material 3 fallback palette (Md3Theme.qml).
export global Theme {
    in-out property <color> background: #111318;
    in-out property <color> surface: #1d2024;
    in-out property <color> elevated: #282a2f;
    in-out property <color> raised: #33353a;
    in-out property <color> outline: #8e9099;
    in-out property <color> outline-variant: #44474f;
    in-out property <color> primary: #a8c7fa;
    in-out property <color> primary-container: #062e6f;
    in-out property <color> error: #ffb4ab;
    in-out property <color> on-error: #690005;
    in-out property <color> on-primary: #062e6f;
    in-out property <color> text: #e2e2e9;
    in-out property <color> muted: #c4c6d0;
    in-out property <color> success: #a8d5a2;
}

export struct EthernetRow { id: string, connected: bool, enabled: bool }
export struct WifiRow { id: string, name: string, device: string, secured: bool, connected: bool, signal: int, profile: string }
export struct SavedWifiRow { id: string, name: string, ssid: string, connected: bool }
export struct BluetoothRow { id: string, name: string, kind: string, connected: bool }

export struct ActionRow { label: string, id: string, active: bool }
export struct ChannelPointRow {
    id: string, label: string, subtitle: string, active: bool,
    image-url: string, image: image, image-loading: bool, tint: color,
}
export struct SystemStats { cpu: float, temperature: float, ram: float, swap: float, has-swap: bool, storage: float }
export struct StorageEntry { label-key: string, size: string, tint: color, fraction: float, offset: float }
export struct SystemStorage { used: string, free: string, total: string, usage: float, other: float, rows: [StorageEntry] }
export struct UpdateEntry {
    id: string, active: bool, busy: bool, git: bool, available: bool, updating: bool, checking: bool,
    version: string, count: int, preview: string, error: string, stage: string, message: string, progress: float,
    package: string, package-progress: float,
}
struct SystemMetric { label: string, tint: color, value: float, empty: string }
export struct AudioLink { id: string, label: string, linked: bool, present: bool, default-output: bool, volume: float }
export struct AudioEntry {
    id: string, label: string, subtitle: string, physical: bool, volume: float, minimum: float, maximum: float,
    step: float, muted: bool, restore: float, routable: bool, per-link: bool, links: [AudioLink],
}
export struct InteractionEntry {
    name: string,
    source: string,
    state: string,
    eta: int,
    alerts: int,
    uuid: string,
    active: bool,
    failed: bool,
    progress: float,
}

export struct DashboardMacroEntry { name: string, state: string, ticket: int }

export struct AutoMacroEntry {
    name: string,
    enabled: bool,
    progress: float,
}

component DashboardSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();
    in property <bool> enabled: true;
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.primary : Theme.raised;
    border-width: checked ? 0px : 2px;
    border-color: Theme.muted;
    Rectangle {
        width: root.checked ? 24px : 16px;
        height: root.checked ? 24px : 16px;
        x: root.checked ? 24px : 6px;
        y: (parent.height - self.height) / 2;
        background: root.checked ? Theme.on-primary : Theme.muted;
        border-radius: self.width / 2;
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
}

// Scrollbar-free replacement for std ScrollView; scrolls by touch drag / wheel.
component Scroller {
    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        @children
    }
}

// Theme-colored indeterminate spinner (the std Spinner ignores Theme).
component LoadingSpinner inherits Rectangle {
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: self.width / 2;
        border-width: 3px;
        border-color: Theme.primary.with-alpha(0.2);
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.primary;
        stroke-width: 3px;
        transform-rotation: mod(animation-tick(), 900ms) / 900ms * 360deg;
        MoveTo { x: 12; y: 1.5; }
        ArcTo { x: 22.5; y: 12; radius-x: 10.5; radius-y: 10.5; sweep: true; }
    }
}

// Full-window backdrop for dialogs: dims what is behind and drives the entry animation.
component DialogScrim inherits Rectangle {
    in property <bool> animated: false;
    in property <float> dim: 0.45;
    // 0 → 1 once the dialog appears; dialog cards bind their opacity/scale to it.
    out property <float> progress: 0;
    animate progress {
        duration: root.animated ? 240ms : 0ms;
        easing: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    init => { self.progress = 1; }
    background: #000000.with-alpha(root.dim * root.progress);
}

component Md3Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 16px;
    min-width: 0px;
}

component GlassCard inherits Md3Card {
    in property <float> tint-opacity: 0.94;
    in property <color> tint: Theme.surface;
    background: root.tint.with-alpha(root.tint-opacity);
    border-width: 1px;
    border-color: Theme.outline-variant;
}

component DrawerTitle inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 600;
    overflow: elide;
}

component DrawerEmpty inherits Text {
    color: Theme.muted;
    font-size: 13px;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
    vertical-stretch: 1;
}

component Md3Button inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> filled: false;
    callback clicked();
    height: 34px;
    width: max(34px, caption.preferred-width + 20px);
    border-radius: 17px;
    border-width: root.filled ? 0px : 1px;
    border-color: root.enabled ? Theme.muted : Theme.raised;
    background: root.filled ? (root.enabled ? Theme.primary : Theme.raised) : hit.pressed ? Theme.elevated : transparent;
    caption := Text {
        text: root.label;
        color: !root.enabled ? Theme.muted : root.filled ? Theme.on-primary : Theme.primary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component DrawerRowText inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> active;
    horizontal-stretch: 1;
    min-width: 0px;
    alignment: center;
    spacing: 1px;
    Text { text: root.title; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
    if root.detail != "" : Text { text: root.detail; color: root.active ? Theme.success : Theme.muted; font-size: 10px; overflow: elide; }
}

component DrawerBluetoothDevice inherits Md3Card {
    in property <BluetoothRow> device;
    in property <string> status;
    in property <bool> paired: false;
    in property <bool> enabled: true;
    callback activated();
    callback removed();
    height: root.paired ? 60px : 54px;
    background: root.device.connected ? Theme.primary-container : Theme.raised;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 28px;
            if root.device.kind == "SPK" : Image {
                source: @image-url("icons/mdi/volume-high.svg");
                colorize: Theme.text;
                width: 22px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.device.kind != "SPK" : Text {
                text: root.device.kind; color: Theme.text; font-size: 9px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        DrawerRowText { title: root.device.name; detail: root.paired ? root.status : ""; active: root.device.connected; }
        if !root.paired : Text { text: root.status; color: Theme.primary; font-size: 10px; vertical-alignment: center; }
    }
    TouchArea {
        x: 0px;
        width: root.paired ? parent.width - 42px : parent.width;
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    if root.paired : Md3Button {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        label: "×";
        enabled: root.enabled;
        clicked => { root.removed(); }
    }
}

component SystemHeading inherits Text {
    color: Theme.text;
    font-size: 12px;
    font-weight: 600;
    overflow: elide;
    vertical-alignment: center;
}

component SystemRing inherits Rectangle {
    in property <length> diameter;
    in property <float> progress;
    in property <color> tint;
    width: root.diameter;
    height: root.diameter;
    border-radius: self.width / 2;
    border-width: 6px;
    border-color: Theme.raised;
    if root.progress >= 1 : Rectangle {
        border-radius: self.width / 2;
        border-width: 6px;
        border-color: root.tint;
    }
    if root.progress > 0 && root.progress < 1 : Path {
        private property <float> edge: root.diameter / 1px;
        private property <float> center: self.edge / 2;
        private property <float> radius: self.center - 3;
        viewbox-width: self.edge;
        viewbox-height: self.edge;
        stroke-width: 6px;
        stroke: root.tint;
        MoveTo { x: center; y: 3; }
        ArcTo {
            radius-x: radius;
            radius-y: radius;
            x: center + radius * sin(root.progress * 360deg);
            y: center - radius * cos(root.progress * 360deg);
            sweep: true;
            large-arc: root.progress > 0.5;
        }
    }
}

component SystemDetail inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    in property <color> tint: transparent;
    in property <color> value-color: Theme.text;
    in property <length> font-size: 12px;
    in property <length> marker-size: 9px;
    in property <length> marker-radius: 5px;
    spacing: 8px;
    if root.tint != transparent : Rectangle {
        width: root.marker-size;
        Rectangle {
            width: root.marker-size;
            height: root.marker-size;
            border-radius: root.marker-radius;
            background: root.tint;
        }
    }
    Text {
        text: root.title;
        color: Theme.muted;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-weight: 500;
        font-size: 12px;
        vertical-alignment: center;
    }
}

component SystemProgress inherits VerticalLayout {
    in property <string> label;
    in property <float> value;
    alignment: start;
    spacing: 3px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: root.label; horizontal-stretch: 1; color: Theme.muted; font-size: 10px; overflow: elide; }
        if root.value >= 0 : Text { text: round(root.value) + "%"; color: Theme.text; font-size: 10px; }
    }
    if root.value >= 0 : Rectangle {
        height: 5px;
        border-radius: 3px;
        background: Theme.raised;
        Rectangle {
            x: 0px;
            width: parent.width * root.value / 100;
            border-radius: 3px;
            background: Theme.primary;
        }
    }
}

component SystemLanguage inherits Rectangle {
    in property <string> language;
    in property <string> english;
    in property <string> german;
    callback selected(string);
    height: 44px;
    border-radius: 22px;
    border-width: 1px;
    border-color: Theme.muted;
    background: Theme.elevated;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.language == "de" ? root.german : root.english;
            color: Theme.text; vertical-alignment: center; font-size: 13px; horizontal-stretch: 1;
        }
        Text { text: "▼"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
    }
    accessible-role: combobox;
    accessible-value: root.language == "de" ? root.german : root.english;
    accessible-action-expand => { choices.show(); }
    TouchArea { clicked => { choices.show(); } }
    choices := PopupWindow {
        x: 0px;
        y: -96px;
        width: root.width;
        height: 92px;
        close-policy: close-on-click-outside;
        Md3Card {
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.raised;
            VerticalLayout {
                padding: 4px;
                for option in [{code: "en", label: root.english}, {code: "de", label: root.german}] : Rectangle {
                    background: option.code == root.language || option-hit.has-hover ? Theme.elevated : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: option.label;
                        color: Theme.text;
                        vertical-alignment: center;
                        font-size: 13px;
                    }
                    option-hit := TouchArea { clicked => { choices.close(); root.selected(option.code); } }
                }
            }
        }
    }
}

component DashboardMacroCard inherits GlassCard {
    tint-opacity: 0.88;
    in property <[DashboardMacroEntry]> macros;
    in property <[AutoMacroEntry]> automatic;
    in property <bool> auto-mode;
    in property <bool> enabled: true;
    in property <string> empty-label;
    callback run(string);
    callback toggle(string, bool);
    vertical-stretch: 1;
    min-height: 0px;
    preferred-height: 180px;
    card-content := Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        clip: true;
        property <int> count: root.auto-mode ? root.automatic.length : root.macros.length;
        // Rows share the full card height; the minimum only matters for very small cards.
        property <length> row-height: max((self.height + 4px) / max(1, self.count) - 4px,
            root.auto-mode ? 32px : 30px);
        // Taller rows get slightly larger labels so they don't look lost.
        property <length> label-size: clamp(self.row-height * 0.24, 11px, 15px);
        if self.count == 0 : Text {
            text: root.empty-label;
            color: Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        rows := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for item in (root.auto-mode ? root.automatic : []) : Rectangle {
                height: card-content.row-height;
                border-radius: 12px;
                background: Theme.raised;
                Rectangle {
                    x: 0px;
                    width: parent.width * item.progress;
                    border-radius: 12px;
                    background: Theme.elevated;
                    animate width { duration: 950ms; }
                    opacity: item.enabled ? 1 : 0;
                    animate opacity { duration: 180ms; }
                    Rectangle { border-radius: 12px; background: Theme.primary; opacity: 0.1; }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 6px;
                    Text {
                        text: item.name;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: card-content.label-size;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        width: 52px;
                        DashboardSwitch {
                            checked: item.enabled;
                            enabled: root.enabled;
                            toggled => { root.toggle(item.name, !item.enabled); }
                        }
                    }
                }
            }
            for item in (root.auto-mode ? [] : root.macros) : Rectangle {
                height: card-content.row-height;
                border-radius: 12px;
                background: macro-touch.pressed ? Theme.elevated : Theme.surface.with-alpha(0.94);
                border-width: 1px;
                border-color: Theme.outline-variant;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text {
                        text: item.name;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: card-content.label-size;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 26px;
                        if item.state != "loading" : Image {
                            width: 16px;
                            height: 16px;
                            source: item.state == "success" ? @image-url("icons/mdi/check.svg")
                                : item.state == "error" ? @image-url("icons/mdi/alert-circle.svg")
                                : @image-url("icons/mdi/play.svg");
                            colorize: Theme.text;
                        }
                        if item.state == "loading" : Spinner {
                            width: 16px;
                            height: 16px;
                            indeterminate: true;
                        }
                    }
                }
                macro-touch := TouchArea { enabled: root.enabled && item.state != "loading"; clicked => { root.run(item.name); } }
            }
        }
    }
}

component SpeedMetric inherits GlassCard {
    in property <string> title;
    in property <string> value;
    in property <string> glyph;
    in property <bool> active;
    tint: root.active ? Theme.elevated : Theme.surface;
    tint-opacity: root.active ? 0.92 : 0.88;
    border-color: root.active ? Theme.primary : Theme.outline-variant;
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text { text: root.glyph; color: Theme.text; font-size: 26px; horizontal-alignment: center; }
            Text { text: root.title; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
            Text { text: root.value; color: Theme.text; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
        }
    }
}

component KioskSearch inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    callback activated();
    callback edited(string);
    callback accepted();
    forward-focus: input;

    height: 44px;
    horizontal-stretch: 1;
    border-radius: 12px;
    background: Theme.raised;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.outline;

    TouchArea { clicked => { input.focus(); } }
    Rectangle {
        x: 16px;
        width: parent.width - 32px;
        clip: true;

        Text {
            text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
            color: Theme.muted;
            font-size: input.font-size;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        input := TextInput {
            property <length> scroll-offset;
            x: clamp(self.scroll-offset, parent.width - self.width - self.text-cursor-width, 0px);
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            font-size: 14px;
            vertical-alignment: center;
            color: Theme.text;
            selection-background-color: Theme.primary;
            selection-foreground-color: Theme.on-primary;
            accessible-placeholder-text: root.placeholder-text;

            cursor-position-changed(position) => {
                if position.x + self.x < 0px {
                    self.scroll-offset = -position.x;
                } else if position.x + self.x > parent.width - self.text-cursor-width {
                    self.scroll-offset = parent.width - self.text-cursor-width - position.x;
                }
            }
            changed has-focus => { if self.has-focus { root.activated(); } }
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
        }
    }
}

component AudioIconControl inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 36px;
    height: 34px;
    border-radius: 17px;
    background: hit.pressed ? Theme.elevated : Theme.raised;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        width: 17px;
        height: 17px;
        source: root.icon;
        colorize: root.enabled ? Theme.text : Theme.muted;
        opacity: root.enabled ? 1 : 0.55;
    }
    hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component AudioFader inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback committed(float);
    out property <bool> dragging: hit.pressed;
    accessible-role: slider;
    accessible-value: round(root.value * 100) + "%";
    accessible-enabled: root.enabled;
    function update-position(position: length) {
        let fraction = clamp((position - 8px) / max(1px, root.width - 16px), 0, 1);
        let increment = max(0.0001, root.step);
        root.value = clamp(root.minimum + round(fraction * (root.maximum - root.minimum) / increment) * increment,
            root.minimum, root.maximum);
    }
    height: 26px;
    horizontal-stretch: 1;
    Rectangle {
        height: 6px;
        x: 8px;
        width: parent.width - 16px;
        border-radius: 3px;
        background: Theme.raised;
        opacity: root.enabled ? 1 : 0.5;
        Rectangle {
            x: 0px;
            width: parent.width * clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
            border-radius: 3px;
            background: Theme.primary;
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) * clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
        border-radius: 8px;
        background: root.enabled ? Theme.primary : Theme.muted;
        border-width: fader-focus.has-focus ? 2px : 0px;
        border-color: Theme.text;
    }
    fader-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.value = clamp(root.value + (event.text == Key.RightArrow ? root.step : -root.step), root.minimum, root.maximum);
            } else if event.text == Key.Home || event.text == Key.End {
                root.value = event.text == Key.Home ? root.minimum : root.maximum;
            } else {
                return reject;
            }
            root.committed(root.value);
            return accept;
        }
    }
    hit := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    fader-focus.focus();
                    root.update-position(self.mouse-x);
                } else if event.kind == PointerEventKind.up {
                    root.update-position(self.mouse-x);
                    root.committed(root.value);
                }
            }
        }
        moved => { if self.pressed { root.update-position(self.mouse-x); } }
    }
}

component KioskAudioRow inherits GlassCard {
    in property <AudioEntry> item;
    in property <string> route-label;
    in property <string> quieter;
    in property <string> louder;
    in property <string> mute-label;
    in property <string> link-volume-label;
    in property <string> levels-label;
    in property <bool> ready;
    property <float> draft: root.item.volume;
    property <float> previous-volume: root.item.restore;
    property <bool> fader-dragging;
    callback volume(float);
    callback mute(float);
    callback routing();
    function adjust(direction: int) {
        root.draft = clamp(root.draft + direction * root.item.step, root.item.minimum, root.item.maximum);
        root.volume(root.draft);
    }
    changed item => { if !root.fader-dragging { root.draft = root.item.volume; } }
    changed draft => { if root.draft > root.item.minimum { root.previous-volume = root.draft; } }
    function toggle-mute() {
        let restore = root.item.volume > root.item.minimum ? root.item.volume : max(root.previous-volume, root.item.restore);
        root.mute(root.item.muted ? clamp(restore, root.item.minimum, root.item.maximum) : 0);
    }
    height: 76px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        HorizontalLayout {
            width: 150px;
            spacing: 5px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text { text: root.item.label; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { text: root.item.subtitle; color: Theme.muted; font-size: 9px; overflow: elide; }
            }
            if root.item.routable : AudioIconControl {
                icon: @image-url("icons/mdi/link-variant.svg");
                label: root.route-label;
                enabled: root.ready;
                clicked => { root.routing(); }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            if !root.item.per-link : AudioFader {
                minimum: root.item.minimum;
                maximum: root.item.maximum;
                step: root.item.step;
                enabled: root.ready && !root.item.muted;
                value <=> root.draft;
                changed dragging => { root.fader-dragging = self.dragging; }
                committed(value) => { root.volume(value); }
            }
            if root.item.per-link : Text {
                height: 26px;
                text: root.link-volume-label;
                color: Theme.muted; font-size: 10px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                if !root.item.per-link : AudioIconControl {
                    icon: @image-url("icons/mdi/minus.svg");
                    label: root.quieter;
                    enabled: root.ready && !root.item.muted;
                    clicked => { root.adjust(-1); }
                }
                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 16px;
                    border-width: root.item.muted ? 0px : 1px;
                    border-color: Theme.muted;
                    background: root.item.muted ? Theme.primary : mute-touch.pressed ? Theme.elevated : Theme.raised;
                    accessible-role: button;
                    accessible-label: root.mute-label;
                    accessible-action-default => { if root.ready { root.toggle-mute(); } }
                    mute-caption := HorizontalLayout {
                        width: mute-label-text.preferred-width + 23px;
                        height: parent.height;
                        spacing: 6px;
                        Rectangle {
                            width: 17px;
                            Image {
                                width: 17px;
                                height: 17px;
                                y: (parent.height - self.height) / 2;
                                source: root.item.muted ? @image-url("icons/mdi/volume-off.svg") : @image-url("icons/mdi/volume-high.svg");
                                colorize: root.item.muted ? Theme.on-primary : Theme.text;
                            }
                        }
                        mute-label-text := Text {
                            text: root.item.per-link ? root.levels-label : round(root.draft * 100) + "%";
                            color: root.item.muted ? Theme.on-primary : Theme.text;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    mute-touch := TouchArea { enabled: root.ready; clicked => { root.toggle-mute(); } }
                }
                if !root.item.per-link : AudioIconControl {
                    icon: @image-url("icons/mdi/plus.svg");
                    label: root.louder;
                    enabled: root.ready && !root.item.muted;
                    clicked => { root.adjust(1); }
                }
            }
        }
    }
}

component MusicIconButton inherits Rectangle {
    in property <string> glyph: "";
    in property <bool> filled: false;
    in property <bool> selected: false;
    in property <length> diameter: root.filled ? 46px : 40px;
    callback clicked();
    width: root.diameter;
    height: self.width;
    border-radius: self.width / 2;
    background: root.filled || root.selected ? Theme.primary : music-tap.pressed ? Theme.elevated : transparent;
    Text {
        text: root.glyph;
        color: root.filled || root.selected ? Theme.on-primary : Theme.text;
        font-size: root.width * (root.filled ? 0.48 : 0.47);
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    music-tap := TouchArea { clicked => { root.clicked(); } }
}

// Cava bars, centered and bottom-aligned; they scale with the available height.
component CavaBars inherits Rectangle {
    in property <[float]> levels;
    in property <length> bar-width: 14px;
    in property <length> gap: 9px;
    in property <length> max-bar-height: 1000px;
    property <length> span: root.levels.length * root.bar-width + max(0, root.levels.length - 1) * root.gap;
    // Bars live in a box capped at max-bar-height, centered vertically.
    property <length> box: min(root.height, root.max-bar-height);
    for level[index] in root.levels : Rectangle {
        width: root.bar-width;
        height: max(root.bar-width * 0.45, root.box * clamp(level, 0, 100) / 100);
        x: (root.width - root.span) / 2 + index * (root.bar-width + root.gap);
        y: (root.height + root.box) / 2 - self.height;
        border-radius: root.bar-width / 2;
        background: Theme.primary;
        animate height { duration: 90ms; easing: ease-out; }
    }
}

component DashboardMusicCard inherits GlassCard {
    in property <string> title;
    in property <string> artist;
    in property <[float]> levels;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <bool> looping;
    in property <bool> requests;
    in property <string> requests-label;
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    callback action(string);
    // Sharing a column with another card switches to the compact layout.
    property <bool> compact: root.height < 320px;
    min-height: 0px;
    vertical-stretch: 1;
    tint-opacity: 0.88;

    if root.compact : VerticalLayout {
        padding: 14px;
        padding-bottom: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: root.artist; color: Theme.muted; font-size: 11px; overflow: elide; }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 6px;
                Text { horizontal-stretch: 0; text: root.requests-label; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                VerticalLayout { alignment: center; DashboardSwitch { checked: root.requests; toggled => { root.action("songrequest_toggle"); } } }
            }
        }
        CavaBars {
            vertical-stretch: 1;
            min-height: 8px;
            levels: root.levels;
            bar-width: 10px;
            gap: 6px;
        }
        HorizontalLayout {
            alignment: space-around;
            MusicIconButton { diameter: 38px; glyph: "⤨"; selected: root.shuffle; clicked => { root.action("shuffle"); } }
            MusicIconButton { diameter: 38px; glyph: "◀"; clicked => { root.action("back"); } }
            MusicIconButton { diameter: 44px; glyph: root.playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.action(root.playing ? "pause" : "play"); } }
            MusicIconButton { diameter: 38px; glyph: "▶"; clicked => { root.action("next"); } }
            MusicIconButton { diameter: 38px; glyph: "↻"; selected: root.looping; clicked => { root.action("loop"); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.position; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle {
                    height: 5px;
                    border-radius: 3px;
                    background: Theme.raised;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.progress, 0, 100) / 100;
                        border-radius: 3px;
                        background: Theme.primary;
                    }
                }
            }
            Text { text: root.duration; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
        }
    }

    if !root.compact : VerticalLayout {
        padding: 20px;
        padding-bottom: 14px;
        spacing: 12px;
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
            Text { text: root.artist; color: Theme.muted; font-size: 13px; horizontal-alignment: center; overflow: elide; }
        }
        CavaBars {
            vertical-stretch: 1;
            min-height: 40px;
            max-bar-height: 220px;
            levels: root.levels;
            bar-width: 24px;
            gap: 14px;
        }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 4px;
            Rectangle {
                height: 7px;
                border-radius: 4px;
                background: Theme.raised;
                Rectangle {
                    x: 0px;
                    width: parent.width * clamp(root.progress, 0, 100) / 100;
                    border-radius: 4px;
                    background: Theme.primary;
                }
            }
            HorizontalLayout {
                Text { text: root.position; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; }
                Text { text: root.duration; color: Theme.muted; font-size: 11px; }
            }
        }
        HorizontalLayout {
            vertical-stretch: 0;
            alignment: space-around;
            MusicIconButton { diameter: 48px; glyph: "⤨"; selected: root.shuffle; clicked => { root.action("shuffle"); } }
            MusicIconButton { diameter: 48px; glyph: "◀"; clicked => { root.action("back"); } }
            MusicIconButton { diameter: 64px; glyph: root.playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.action(root.playing ? "pause" : "play"); } }
            MusicIconButton { diameter: 48px; glyph: "▶"; clicked => { root.action("next"); } }
            MusicIconButton { diameter: 48px; glyph: "↻"; selected: root.looping; clicked => { root.action("loop"); } }
        }
        HorizontalLayout {
            vertical-stretch: 0;
            alignment: center;
            spacing: 10px;
            Text { text: root.requests-label; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
            VerticalLayout { alignment: center; DashboardSwitch { checked: root.requests; toggled => { root.action("songrequest_toggle"); } } }
        }
    }
}

component DashboardInteractionsCard inherits GlassCard {
    in property <[InteractionEntry]> items;
    in property <string> empty-label;
    pure callback meta(InteractionEntry) -> string;
    callback remove(string);
    tint-opacity: 0.88;
    vertical-stretch: 1;
    min-height: 0px;
    VerticalLayout {
        padding: 14px;
        spacing: 5px;
        if root.items.length == 0 : Text {
            vertical-stretch: 1;
            text: root.empty-label;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.items.length > 0 : Scroller {
            min-height: 0px;
            VerticalLayout {
                spacing: 5px;
                alignment: start;
                for item in root.items : Rectangle {
                    height: 50px;
                    border-radius: 12px;
                    background: (item.active ? Theme.elevated : Theme.raised).with-alpha(0.94);
                    Rectangle {
                        height: 3px;
                        y: parent.height - self.height;
                        x: 0px;
                        width: parent.width * max(0, min(1, item.progress));
                        border-radius: 2px;
                        background: Theme.success;
                        visible: item.active;
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: item.active ? Theme.success : (item.failed ? Theme.error : Theme.outline);
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text { text: item.name; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                            Text { text: root.meta(item); color: item.failed ? Theme.error : Theme.muted; font-size: 8px; overflow: elide; }
                            if item.uuid != "" : Text { text: item.uuid; color: Theme.outline; font-size: 7px; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            MusicIconButton { width: 34px; height: 34px; glyph: "×"; clicked => { root.remove(item.uuid); } }
                        }
                    }
                }
            }
        }
    }
}

component PillButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();
    height: 40px;
    horizontal-stretch: 0;
    min-width: min(caption.preferred-width + 32px, 96px);
    preferred-width: max(82px, caption.preferred-width + 36px);
    border-radius: 20px;
    background: root.selected ? (pill-touch.pressed ? Theme.primary.darker(0.15) : Theme.primary)
        : pill-touch.pressed ? Theme.raised : Theme.elevated;
    border-width: 1px;
    border-color: root.selected ? Theme.primary : Theme.outline-variant;
    caption := Text {
        x: 16px;
        width: parent.width - 32px;
        text: root.label;
        color: root.selected ? Theme.on-primary : Theme.text;
        font-size: 13px;
        font-weight: root.selected ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    pill-touch := TouchArea { clicked => { root.clicked(); } }
}

// Shown over each dashboard slot while editing: change the card, pick its macros.
component SlotEditOverlay inherits Rectangle {
    in property <bool> empty;
    in property <string> card-label;
    in property <string> macros-label;
    callback change-card();
    callback choose-macros();
    border-radius: 16px;
    border-width: 2px;
    border-color: Theme.primary;
    background: root.empty ? Theme.surface.with-alpha(0.6) : Theme.background.with-alpha(0.78);
    TouchArea { clicked => { root.change-card(); } }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 12px;
        HorizontalLayout {
            alignment: center;
            PillButton {
                max-width: 260px;
                label: (root.empty ? "+  " : "") + root.card-label + (root.empty ? "" : "  ▾");
                selected: true;
                clicked => { root.change-card(); }
            }
        }
        if root.macros-label != "" : HorizontalLayout {
            alignment: center;
            PillButton { max-width: 260px; label: root.macros-label; clicked => { root.choose-macros(); } }
        }
    }
}

// Key caps match the original Md3Keyboard (8px radius, small gaps, pressed state).
// Shared row for the controls page and the dashboard pickers.
component ListTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-leading: false;
    in property <image> leading-image;
    in property <image> leading-icon;
    in property <color> leading-tint: transparent;
    in property <bool> leading-loading: false;
    in property <bool> leading-dim: false;
    in property <bool> highlighted: false;
    // "switch", "check" or "play"
    in property <string> trailing: "";
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 60px;
    border-radius: 14px;
    background: tile-tap.pressed ? Theme.elevated
        : root.highlighted ? Theme.primary-container.with-alpha(0.94) : Theme.surface.with-alpha(0.9);
    border-width: 1px;
    border-color: root.highlighted ? Theme.primary : Theme.outline-variant;
    opacity: root.enabled ? 1 : 0.6;
    tile-tap := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.show-leading ? 10px : 16px;
        padding-right: 12px;
        spacing: 12px;
        if root.show-leading : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: root.leading-tint != transparent ? root.leading-tint : Theme.raised;
                clip: true;
                if root.leading-image.width > 0 : Image {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    source: root.leading-image;
                    image-fit: contain;
                    opacity: root.leading-dim ? 0.45 : 1;
                }
                if root.leading-image.width == 0 && !root.leading-loading : Image {
                    width: 22px;
                    height: 22px;
                    source: root.leading-icon;
                    colorize: Theme.text;
                }
                if root.leading-loading : LoadingSpinner { size: 22px; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.subtitle != "" : Text { text: root.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        if root.trailing == "switch" : VerticalLayout {
            alignment: center;
            DashboardSwitch { checked: root.checked; enabled: root.enabled; toggled => { root.clicked(); } }
        }
        if root.trailing == "check" : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 8px;
                border-width: root.checked ? 0px : 2px;
                border-color: Theme.muted;
                background: root.checked ? Theme.primary : transparent;
                if root.checked : Image { width: 18px; height: 18px; source: @image-url("icons/mdi/check.svg"); colorize: Theme.on-primary; }
            }
        }
        if root.trailing == "play" : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: tile-tap.pressed ? Theme.primary : Theme.raised;
                Image { width: 18px; height: 18px; source: @image-url("icons/mdi/play.svg"); colorize: tile-tap.pressed ? Theme.on-primary : Theme.text; }
            }
        }
    }
}

component TouchKey inherits Rectangle {
    in property <string> label: "";
    in property <bool> accent: false;
    callback clicked();
    vertical-stretch: 1;
    border-radius: 8px;
    background: touch.pressed ? Theme.primary : (accent ? Theme.elevated : Theme.raised);
    Text {
        text: root.label;
        color: touch.pressed ? Theme.on-primary : Theme.text;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export struct PickerEntry {
    name: string,
    selected: bool,
    thumbnail: image,
    loading: bool,
}

component NavItem inherits Rectangle {
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    in property <image> icon;
    in property <image> active-icon;
    in property <bool> active: false;
    callback clicked();
    width: 72px;
    height: 42px;
    background: transparent;
    Rectangle {
        width: 56px;
        height: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: root.active ? Theme.primary : transparent;
        Image {
            width: 21px;
            height: 21px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.active ? root.active-icon : root.icon;
            image-fit: contain;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}


export component App inherits Window {
    title: "Streambot Touch";
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 700px;
    min-height: 450px;
    background: Theme.background;

    in-out property <int> page: 0;
    in-out property <string> connection: "Waiting for backend";
    in-out property <string> backend-stage: "";
    in-out property <bool> backend-ready;
    pure callback locale-text(string, string) -> string;
    pure callback fill-text(string, string, string) -> string;
    pure callback startup-stage(string, string) -> string;
    in-out property <string> detail: "";
    in-out property <string> track;
    in-out property <string> music-state: "";
    in-out property <string> interaction-summary;
    in-out property <SystemStats> system-stats: { cpu: -1, temperature: -1, ram: -1, swap: -1, has-swap: false, storage: -1 };
    in-out property <SystemStorage> system-storage: { used: "—", free: "—", total: "—", usage: -1, other: 0, rows: [] };
    in-out property <bool> updates-available;
    in-out property <bool> updates-checking;
    in-out property <bool> updates-running;
    in-out property <bool> backend-update-running;
    property <[SystemMetric]> system-metrics: [
        { label: root.loc("system_cpu_usage"), tint: #ef5350, value: root.system-stats.cpu, empty: "—" },
        { label: root.loc("system_ram_usage"), tint: #ffb300, value: root.system-stats.ram, empty: "—" },
        { label: root.loc("system_swap_usage"), tint: #ab47bc,
            value: root.system-stats.has-swap ? root.system-stats.swap : -1, empty: root.system-stats.has-swap ? "—" : root.loc("system_no_swap") },
        { label: root.loc("system_internal_storage_usage"), tint: #26c6da,
            value: root.system-stats.storage >= 0 ? root.system-stats.storage : root.system-storage.usage, empty: "—" },
    ];
    pure function update-stage(stage: string) -> string {
        let key = "system_updates_stage_" + stage;
        let translation = root.loc(key);
        return stage == "" ? root.loc("system_updates_updating") : translation == key ? stage : translation;
    }
    in-out property <string> speedtest-stage: "idle";
    in-out property <string> speedtest-ping: "—";
    in-out property <string> speedtest-download: "—";
    in-out property <string> speedtest-upload: "—";
    in-out property <string> speedtest-error;
    in-out property <bool> speedtest-starting;
    callback speedtest-status();
    in-out property <[string]> macros: [];
    in-out property <[ActionRow]> auto-macros: [];
    in-out property <[ChannelPointRow]> channel-points: [];
    pure callback filter-names([string], string) -> [string];
    pure callback filter-rows([ActionRow], string) -> [ActionRow];
    pure callback filter-points([ChannelPointRow], string) -> [ChannelPointRow];
    property <[string]> shown-macros: root.filter-names(root.macros, root.search);
    property <[ActionRow]> shown-auto-macros: root.filter-rows(root.auto-macros, root.search);
    property <[ChannelPointRow]> shown-channel-points: root.filter-points(root.channel-points, root.search);
    in-out property <[AudioEntry]> audio-interfaces: [];
    in-out property <string> search: "";
    in-out property <int> macro-tab: 0;
    in-out property <string> feedback: "";
    in-out property <bool> dashboard-editing: false;
    in-out property <string> left-slot-0: "interactions";
    in-out property <string> left-slot-1: "auto_macros";
    in-out property <string> right-slot-0: "music";
    in-out property <string> right-slot-1: "";
    in-out property <string> edit-left-0: "interactions";
    in-out property <string> edit-left-1: "auto_macros";
    in-out property <string> edit-right-0: "music";
    in-out property <string> edit-right-1: "";
    in-out property <bool> power-menu-open: false;
    in-out property <bool> network-drawer-open: false;
    property <bool> drawer-dragging: false;
    property <length> drawer-delta: 0px;
    property <duration> drawer-drag-start: 0ms;
    property <bool> saved-wifi-open: false;
    property <string> forget-name;
    property <string> wifi-name;
    property <string> drawer-pairing;
    in-out property <string> drawer-network-error;
    in-out property <string> drawer-error;
    in-out property <bool> wifi-enabled;
    in-out property <bool> wifi-available;
    in-out property <bool> bluetooth-available;
    in-out property <bool> bluetooth-powered;
    in-out property <bool> bluetooth-scanning;
    in-out property <bool> bluetooth-busy;
    in-out property <bool> bluetooth-refreshing;
    in-out property <string> bluetooth-error;
    in-out property <int> bluetooth-connected-count;
    in-out property <bool> touch-keyboard-open: false;
    in-out property <bool> touch-keyboard-shift: false;
    in-out property <bool> touch-keyboard-symbols: false;
    callback drawer-visibility(bool);
    callback drawer-command(string,string,string);
    in-out property <bool> drawer-busy;
    in-out property <bool> drawer-refreshing;
    in-out property <[WifiRow]> wifi;
    in-out property <[EthernetRow]> ethernet;
    in-out property <[SavedWifiRow]> saved-wifi;
    in-out property <[BluetoothRow]> paired-devices;
    in-out property <[BluetoothRow]> discovered-devices;
    in-out property <string> commander-url;
    in-out property <image> commander-qr;
    in-out property <string> wifi-target;
    in-out property <string> wifi-password;
    property <string> confirm-forget;

    changed network-drawer-open => {
        if !root.network-drawer-open {
            root.saved-wifi-open = false;
            root.confirm-forget = "";
            if root.wifi-target != "" { root.close-wifi-password(); }
        }
        root.drawer-visibility(root.network-drawer-open);
    }
    pure function connection-status(connected: bool) -> string {
        return connected ? root.loc("connected") : root.loc("disconnected");
    }
    function start-drawer-drag() {
        root.drawer-delta = 0px;
        root.drawer-drag-start = animation-tick();
        root.drawer-dragging = true;
    }
    function settle-drawer(distance: length, opening: bool) {
        let far-enough = distance > root.height * 0.28;
        let fast-enough = distance > 20px && distance / 1px > (animation-tick() - root.drawer-drag-start) / 1s * 850;
        let tap = abs(distance / 1px) < 8;
        root.drawer-dragging = false;
        root.network-drawer-open = (far-enough || fast-enough || (!opening && tap)) ? opening : !opening;
    }
    function close-wifi-password() {
        root.touch-keyboard-open = false;
        root.wifi-target = "";
        root.wifi-password = "";
    }
    function submit-wifi-password() {
        if root.wifi-password != "" && !root.drawer-busy {
            root.drawer-command("wifi-connect", root.wifi-target, root.wifi-password);
            root.close-wifi-password();
        }
    }
    in-out property <string> language: "en";
    callback choose-language(string);
    pure function loc(key: string) -> string { return root.locale-text(root.language, key); }
    pure function interaction-meta(item: InteractionEntry) -> string {
        let source-key = "interaction_source_" + item.source;
        let state-key = "interaction_state_" + item.state;
        let source = root.loc(source-key);
        let state = root.loc(state-key);
        return (source == source-key ? item.source : source) + " · " + (state == state-key ? item.state : state)
            + (item.eta > 0 ? " · " + item.eta + "s" : "")
            + (item.alerts > 0 ? " · " + root.loc("interaction_alerts") + " " + item.alerts : "");
    }
    // While editing, the dashboard previews the draft layout in place.
    property <string> view-left-0: root.dashboard-editing ? root.edit-left-0 : root.left-slot-0;
    property <string> view-left-1: root.dashboard-editing ? root.edit-left-1 : root.left-slot-1;
    property <string> view-right-0: root.dashboard-editing ? root.edit-right-0 : root.right-slot-0;
    property <string> view-right-1: root.dashboard-editing ? root.edit-right-1 : root.right-slot-1;
    // Empty slots stay visible (as "+" tiles) while editing.
    pure function slot-shown(card: string, other: string) -> bool {
        return card != "" || root.dashboard-editing;
    }
    // Two visible slots share the column evenly; a lone slot fills it.
    pure function slot-height(card: string, other: string) -> length {
        let column = content-area.height - 20px;
        return root.slot-shown(other, card) ? (column - 8px) / 2 : column;
    }
    pure function slot-macros-label(card: string) -> string {
        return card == "macros"
            ? root.fill-text(root.loc("dashboard_selected_count"), "%1", root.dashboard-selected-macros + "")
            : card == "auto_macros"
                ? root.fill-text(root.loc("dashboard_selected_count"), "%1", root.dashboard-selected-auto-macros + "")
                : "";
    }
    pure function card-name(card: string) -> string {
        return root.loc(card == "" ? "dashboard_empty" : "dashboard_card_" + card);
    }

    callback keyboard-input(string);
    callback dashboard-save(string, string, string, string);
    callback power-action(string);
    in-out property <bool> dashboard-picker-open: false;
    in-out property <bool> wallpaper-picker-loading;
    callback wallpaper-picker-closed();
    // The visualizer stream is only needed while a music card is on screen.
    out property <bool> music-visible: root.page == 0
        && (root.view-left-0 == "music" || root.view-left-1 == "music"
            || root.view-right-0 == "music" || root.view-right-1 == "music");
    callback music-visible-changed(bool);
    changed music-visible => { root.music-visible-changed(self.music-visible); }
    changed dashboard-picker-open => {
        if !root.dashboard-picker-open {
            root.touch-keyboard-open = false;
            if root.dashboard-picker-kind == "wallpaper" {
                root.wallpaper-picker-closed();
                root.dashboard-picker-items = [];
            }
        }
    }
    // Motion: enabled from Rust only when rendering through Vulkan.
    in-out property <bool> gpu-effects: false;
    property <bool> intro-running: false;
    property <duration> intro-start;
    property <bool> page-running: false;
    property <duration> page-start;
    // 0 → 1 over the startup animation / a page switch; 1 when idle.
    // animation-tick() is only read while running, so idle frames stay idle.
    property <float> intro: root.intro-running ? clamp((animation-tick() - root.intro-start) / 1100ms, 0, 1) : 1;
    property <float> page-reveal: root.page-running
        ? root.ease-out(clamp((animation-tick() - root.page-start) / 340ms, 0, 1)) : 1;
    pure function ease-out(t: float) -> float { return 1 - pow(1 - t, 3); }
    // Eased progress of an intro stage running from `from` to `to` (fractions of the intro).
    pure function stage(from: float, to: float) -> float {
        return root.ease-out(clamp((root.intro - from) / (to - from), 0, 1));
    }
    public function start-intro() {
        root.gpu-effects = true;
        root.intro-start = animation-tick();
        root.intro-running = true;
    }
    motion-timer := Timer {
        interval: 100ms;
        running: root.intro-running || root.page-running;
        triggered => {
            if root.intro-running && animation-tick() - root.intro-start > 1150ms { root.intro-running = false; }
            if root.page-running && animation-tick() - root.page-start > 380ms { root.page-running = false; }
        }
    }
    // Swipe between pages: the outgoing page stays alive until the swipe ends.
    property <int> previous-page: 0;
    function go-to(target: int) {
        if target == root.page { return; }
        if root.gpu-effects {
            root.previous-page = root.page;
            root.page-start = animation-tick();
            root.page-running = true;
        }
        root.page = target;
    }
    pure function page-shown(index: int) -> bool {
        return root.page == index || (root.page-running && root.previous-page == index);
    }
    // Pages to the right of the current one enter from the right, and vice versa.
    pure function page-x(index: int) -> length {
        if !root.page-running || root.previous-page == root.page { return 0px; }
        let direction = root.page > root.previous-page ? 1 : -1;
        return index == root.page
            ? (1 - root.page-reveal) * content-area.width * direction
            : -root.page-reveal * content-area.width * direction;
    }
    changed page => {
        root.touch-keyboard-open = false;
        root.routing = "";
        if root.page == 4 && root.connection == "Connected" { root.speedtest-status(); }
    }
    property <length> keyboard-height: root.touch-keyboard-symbols
        ? min(300px, root.height * 0.50) : min(250px, root.height * 0.42);
    function hide-keyboard() {
        root.touch-keyboard-open = false;
        keyboard-dismiss-focus.focus();
    }
    keyboard-dismiss-focus := FocusScope { width: 0px; height: 0px; }
    in-out property <string> dashboard-picker-kind: "";
    in-out property <string> dashboard-picker-search: "";
    in-out property <[PickerEntry]> dashboard-picker-items: [];
    in-out property <int> dashboard-selected-macros;
    in-out property <int> dashboard-selected-auto-macros;
    in-out property <image> wallpaper-image;
    in-out property <string> wallpaper-label;
    in-out property <[DashboardMacroEntry]> dashboard-macro-list: [];
    callback dashboard-open-picker(string);
    callback dashboard-filter(string);
    callback dashboard-select-option(string);
    callback dashboard-apply-picker();
    callback dashboard-editor-open();
    callback dashboard-editor-reset();


    in-out property <bool> show-dashboard-macros: false;
    in-out property <[InteractionEntry]> dashboard-interactions: [];
    in-out property <[AutoMacroEntry]> dashboard-auto-macros: [];
    in-out property <string> music-title;
    in-out property <string> music-artist;
    in-out property <bool> music-playing: false;
    in-out property <bool> music-shuffle: false;
    in-out property <bool> music-loop: false;
    in-out property <bool> music-song-requests: false;
    in-out property <float> music-progress: 0;
    in-out property <string> music-position: "0:00";
    in-out property <string> music-duration: "0:00";
    in-out property <[float]> cava-bars: [0, 0, 0, 0, 0];

    callback remove-interaction(string);
    callback trigger-macro(string);
    callback toggle-auto-macro(string,bool);
    callback toggle-channel-point(string);
    callback music-action(string);
    callback speedtest-start();
    callback update-refresh();
    callback change-volume(AudioEntry,float,bool);
    callback link-output(string,string,bool);
    callback per-link-control(string,bool);
    callback link-volume(string,string,float);
    callback run-update(string);
    callback update-all();
    callback advance-updates();
    callback cancel-updates();
    in-out property <string> updating-manager;
    in-out property <bool> osd-visible;
    in-out property <int> osd-revision;
    in-out property <AudioEntry> osd-item;
    in-out property <[UpdateEntry]> updates;
    in-out property <string> routing;
    in-out property <string> theme-wallpaper;
    in-out property <bool> speedtest-running;
    pure callback matches(string,string) -> bool;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.wallpaper-image;
        image-fit: cover;
        opacity: root.stage(0, 0.5);
        transform-scale: 1.08 - 0.08 * root.stage(0, 0.9);
    }
    VerticalLayout {
        spacing: 0px;
        content-area := Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;
            // Quickshell's content area ends directly above the bottom navigation.
            // DashboardPage.qml: 10px margins, 8px columns, no card headings.
            if root.page-shown(0) : HorizontalLayout {
                x: root.page-x(0);
                padding: 10px;
                spacing: 8px;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    width: (root.width - 28px) / 2;
                    if root.slot-shown(root.view-left-0, root.view-left-1) : Rectangle {
                        height: root.slot-height(root.view-left-0, root.view-left-1);
                        opacity: root.stage(0.22, 0.62);
                        transform-scale: 0.92 + 0.08 * root.stage(0.22, 0.62);
                        if root.view-left-0 == "interactions" : DashboardInteractionsCard {
                            items: root.dashboard-interactions;
                            empty-label: root.loc("no_interactions");
                            meta(item) => { return root.interaction-meta(item); }
                            remove(uuid) => { root.remove-interaction(uuid); }
                        }
                        if root.view-left-0 == "auto_macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            automatic: root.dashboard-auto-macros;
                            auto-mode: true;
                            empty-label: root.loc("no_auto_macros");
                            toggle(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                        }
                        if root.view-left-0 == "macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            macros: root.dashboard-macro-list;
                            empty-label: root.loc("dashboard_no_macros");
                            run(name) => { root.trigger-macro(name); }
                        }
                        if root.view-left-0 == "music" : DashboardMusicCard {
                            title: root.music-title != "" ? root.music-title : root.loc("no_song");
                            artist: root.music-artist != "" ? root.music-artist : root.loc("unknown_artist");
                            levels: root.cava-bars;
                            playing: root.music-playing;
                            shuffle: root.music-shuffle;
                            looping: root.music-loop;
                            requests: root.music-song-requests;
                            requests-label: root.loc("song_requests");
                            progress: root.music-progress;
                            position: root.music-position;
                            duration: root.music-duration;
                            action(name) => { root.music-action(name); }
                        }
                        if root.dashboard-editing : SlotEditOverlay {
                            empty: root.view-left-0 == "";
                            card-label: root.view-left-0 == "" ? root.loc("dashboard_choose_card") : root.card-name(root.view-left-0);
                            macros-label: root.slot-macros-label(root.view-left-0);
                            change-card => { root.dashboard-open-picker("slot:left-0"); }
                            choose-macros => { root.dashboard-open-picker(root.view-left-0); }
                        }
                    }
                    if root.slot-shown(root.view-left-1, root.view-left-0) : Rectangle {
                        height: root.slot-height(root.view-left-1, root.view-left-0);
                        opacity: root.stage(0.38, 0.78);
                        transform-scale: 0.92 + 0.08 * root.stage(0.38, 0.78);
                        if root.view-left-1 == "interactions" : DashboardInteractionsCard {
                            items: root.dashboard-interactions;
                            empty-label: root.loc("no_interactions");
                            meta(item) => { return root.interaction-meta(item); }
                            remove(uuid) => { root.remove-interaction(uuid); }
                        }
                        if root.view-left-1 == "auto_macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            automatic: root.dashboard-auto-macros;
                            auto-mode: true;
                            empty-label: root.loc("no_auto_macros");
                            toggle(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                        }
                        if root.view-left-1 == "macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            macros: root.dashboard-macro-list;
                            empty-label: root.loc("dashboard_no_macros");
                            run(name) => { root.trigger-macro(name); }
                        }
                        if root.view-left-1 == "music" : DashboardMusicCard {
                            title: root.music-title != "" ? root.music-title : root.loc("no_song");
                            artist: root.music-artist != "" ? root.music-artist : root.loc("unknown_artist");
                            levels: root.cava-bars;
                            playing: root.music-playing;
                            shuffle: root.music-shuffle;
                            looping: root.music-loop;
                            requests: root.music-song-requests;
                            requests-label: root.loc("song_requests");
                            progress: root.music-progress;
                            position: root.music-position;
                            duration: root.music-duration;
                            action(name) => { root.music-action(name); }
                        }
                        if root.dashboard-editing : SlotEditOverlay {
                            empty: root.view-left-1 == "";
                            card-label: root.view-left-1 == "" ? root.loc("dashboard_choose_card") : root.card-name(root.view-left-1);
                            macros-label: root.slot-macros-label(root.view-left-1);
                            change-card => { root.dashboard-open-picker("slot:left-1"); }
                            choose-macros => { root.dashboard-open-picker(root.view-left-1); }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    width: (root.width - 28px) / 2;
                    if root.slot-shown(root.view-right-0, root.view-right-1) : Rectangle {
                        height: root.slot-height(root.view-right-0, root.view-right-1);
                        opacity: root.stage(0.3, 0.7);
                        transform-scale: 0.92 + 0.08 * root.stage(0.3, 0.7);
                        if root.view-right-0 == "interactions" : DashboardInteractionsCard {
                            items: root.dashboard-interactions;
                            empty-label: root.loc("no_interactions");
                            meta(item) => { return root.interaction-meta(item); }
                            remove(uuid) => { root.remove-interaction(uuid); }
                        }
                        if root.view-right-0 == "auto_macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            automatic: root.dashboard-auto-macros;
                            auto-mode: true;
                            empty-label: root.loc("no_auto_macros");
                            toggle(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                        }
                        if root.view-right-0 == "macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            macros: root.dashboard-macro-list;
                            empty-label: root.loc("dashboard_no_macros");
                            run(name) => { root.trigger-macro(name); }
                        }
                        if root.view-right-0 == "music" : DashboardMusicCard {
                            title: root.music-title != "" ? root.music-title : root.loc("no_song");
                            artist: root.music-artist != "" ? root.music-artist : root.loc("unknown_artist");
                            levels: root.cava-bars;
                            playing: root.music-playing;
                            shuffle: root.music-shuffle;
                            looping: root.music-loop;
                            requests: root.music-song-requests;
                            requests-label: root.loc("song_requests");
                            progress: root.music-progress;
                            position: root.music-position;
                            duration: root.music-duration;
                            action(name) => { root.music-action(name); }
                        }
                        if root.dashboard-editing : SlotEditOverlay {
                            empty: root.view-right-0 == "";
                            card-label: root.view-right-0 == "" ? root.loc("dashboard_choose_card") : root.card-name(root.view-right-0);
                            macros-label: root.slot-macros-label(root.view-right-0);
                            change-card => { root.dashboard-open-picker("slot:right-0"); }
                            choose-macros => { root.dashboard-open-picker(root.view-right-0); }
                        }
                    }
                    if root.slot-shown(root.view-right-1, root.view-right-0) : Rectangle {
                        height: root.slot-height(root.view-right-1, root.view-right-0);
                        opacity: root.stage(0.46, 0.86);
                        transform-scale: 0.92 + 0.08 * root.stage(0.46, 0.86);
                        if root.view-right-1 == "interactions" : DashboardInteractionsCard {
                            items: root.dashboard-interactions;
                            empty-label: root.loc("no_interactions");
                            meta(item) => { return root.interaction-meta(item); }
                            remove(uuid) => { root.remove-interaction(uuid); }
                        }
                        if root.view-right-1 == "auto_macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            automatic: root.dashboard-auto-macros;
                            auto-mode: true;
                            empty-label: root.loc("no_auto_macros");
                            toggle(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                        }
                        if root.view-right-1 == "macros" : DashboardMacroCard {
                            enabled: root.connection == "Connected";
                            macros: root.dashboard-macro-list;
                            empty-label: root.loc("dashboard_no_macros");
                            run(name) => { root.trigger-macro(name); }
                        }
                        if root.view-right-1 == "music" : DashboardMusicCard {
                            title: root.music-title != "" ? root.music-title : root.loc("no_song");
                            artist: root.music-artist != "" ? root.music-artist : root.loc("unknown_artist");
                            levels: root.cava-bars;
                            playing: root.music-playing;
                            shuffle: root.music-shuffle;
                            looping: root.music-loop;
                            requests: root.music-song-requests;
                            requests-label: root.loc("song_requests");
                            progress: root.music-progress;
                            position: root.music-position;
                            duration: root.music-duration;
                            action(name) => { root.music-action(name); }
                        }
                        if root.dashboard-editing : SlotEditOverlay {
                            empty: root.view-right-1 == "";
                            card-label: root.view-right-1 == "" ? root.loc("dashboard_choose_card") : root.card-name(root.view-right-1);
                            macros-label: root.slot-macros-label(root.view-right-1);
                            change-card => { root.dashboard-open-picker("slot:right-1"); }
                            choose-macros => { root.dashboard-open-picker(root.view-right-1); }
                        }
                    }
                }
            }
            if root.page == 0 && root.dashboard-editing && root.feedback != "" : Rectangle {
                x: (parent.width - self.width) / 2;
                y: 16px;
                width: min(parent.width - 32px, feedback-text.preferred-width + 28px);
                height: 32px;
                border-radius: 16px;
                background: Theme.error;
                feedback-text := Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.feedback;
                    color: Theme.on-error;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.page-shown(1) : VerticalLayout {
                x: root.page-x(1);
                padding: 10px;
                if root.audio-interfaces.length == 0 : DrawerEmpty {
                    text: root.loc("audio_no_outputs");
                }
                if root.audio-interfaces.length > 0 : Scroller {
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        for item[index] in root.audio-interfaces : VerticalLayout {
                            spacing: 8px;
                            if index > 0 && item.physical && !root.audio-interfaces[index - 1].physical : Rectangle {
                                height: 1px;
                                background: Theme.raised;
                            }
                            KioskAudioRow {
                                item: item;
                                ready: root.connection == "Connected";
                                quieter: root.loc("audio_volume_down");
                                louder: root.loc("audio_volume_up");
                                route-label: root.loc("audio_link_outputs");
                                mute-label: item.muted ? root.loc("audio_unmute") : root.loc("audio_mute");
                                link-volume-label: root.loc("audio_per_link_hint");
                                levels-label: root.loc("audio_per_link_short");
                                volume(value) => { root.change-volume(item, value, false); }
                                mute(value) => { root.change-volume(item, value, true); }
                                routing => { root.routing = item.id; }
                            }
                        }
                    }
                }
            }
            if root.page-shown(2) : VerticalLayout {
                x: root.page-x(2);
                padding: 10px;
                padding-bottom: root.touch-keyboard-open ? max(10px, root.keyboard-height - 42px) : 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    PillButton { min-width: 132px; label: root.loc("macros"); selected: root.macro-tab == 0; clicked => { root.macro-tab = 0; } }
                    PillButton { min-width: 132px; label: root.loc("auto_macros"); selected: root.macro-tab == 1; clicked => { root.macro-tab = 1; } }
                    PillButton { min-width: 160px; label: root.loc("channel_points"); selected: root.macro-tab == 2; clicked => { root.macro-tab = 2; } }
                }
                KioskSearch {
                    background: Theme.raised.with-alpha(0.94);
                    placeholder-text: root.loc(root.macro-tab == 0 ? "macro_search"
                        : root.macro-tab == 1 ? "auto_macro_search" : "channel_points_search");
                    text <=> root.search;
                    activated => { root.touch-keyboard-open = true; }
                    accepted => { root.hide-keyboard(); }
                }
                if root.macro-tab == 0 && root.shown-macros.length == 0 : DrawerEmpty {
                    text: root.loc("macro_no_results");
                }
                if root.macro-tab == 0 && root.shown-macros.length > 0 : Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        grid-0 := Rectangle {
                            property <length> gap: 8px;
                            property <int> columns: self.width >= 640px ? 2 : 1;
                            property <length> tile-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                            height: ceil(root.shown-macros.length / self.columns) * (60px + self.gap) - self.gap;
                            for item[i] in root.shown-macros : ListTile {
                                x: mod(i, grid-0.columns) * (grid-0.tile-width + grid-0.gap);
                                y: floor(i / grid-0.columns) * (60px + grid-0.gap);
                                width: grid-0.tile-width;
                                title: item;
                                trailing: "play";
                                enabled: root.connection == "Connected";
                                clicked => { root.trigger-macro(item); }
                            }
                        }
                    }
                }
                if root.macro-tab == 1 && root.shown-auto-macros.length == 0 : DrawerEmpty {
                    text: root.loc("auto_macro_no_results");
                }
                if root.macro-tab == 1 && root.shown-auto-macros.length > 0 : Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        grid-1 := Rectangle {
                            property <length> gap: 8px;
                            property <int> columns: self.width >= 640px ? 2 : 1;
                            property <length> tile-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                            height: ceil(root.shown-auto-macros.length / self.columns) * (60px + self.gap) - self.gap;
                            for item[i] in root.shown-auto-macros : ListTile {
                                x: mod(i, grid-1.columns) * (grid-1.tile-width + grid-1.gap);
                                y: floor(i / grid-1.columns) * (60px + grid-1.gap);
                                width: grid-1.tile-width;
                                title: item.label;
                                highlighted: item.active;
                                trailing: "switch";
                                checked: item.active;
                                enabled: root.connection == "Connected";
                                clicked => { root.toggle-auto-macro(item.id, !item.active); }
                            }
                        }
                    }
                }
                if root.macro-tab == 2 && root.shown-channel-points.length == 0 : DrawerEmpty {
                    text: root.loc("channel_points_no_results");
                }
                if root.macro-tab == 2 && root.shown-channel-points.length > 0 : Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        grid-2 := Rectangle {
                            property <length> gap: 8px;
                            property <int> columns: self.width >= 640px ? 2 : 1;
                            property <length> tile-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                            height: ceil(root.shown-channel-points.length / self.columns) * (60px + self.gap) - self.gap;
                            for item[i] in root.shown-channel-points : ListTile {
                                x: mod(i, grid-2.columns) * (grid-2.tile-width + grid-2.gap);
                                y: floor(i / grid-2.columns) * (60px + grid-2.gap);
                                width: grid-2.tile-width;
                                title: item.label;
                                subtitle: item.subtitle;
                                show-leading: true;
                                leading-image: item.image;
                                leading-icon: @image-url("icons/mdi/play.svg");
                                leading-tint: item.tint;
                                leading-loading: item.image-loading;
                                leading-dim: !item.active;
                                highlighted: item.active;
                                trailing: "switch";
                                checked: item.active;
                                enabled: root.connection == "Connected";
                                clicked => { root.toggle-channel-point(item.id); }
                            }
                        }
                    }
                }
            }
            if root.page-shown(3) : HorizontalLayout {
                x: root.page-x(3);
                padding: 10px;
                spacing: 8px;
                VerticalLayout {
                    spacing: 8px;
                    width: (root.width - 28px) / 2;
                    GlassCard {
                        height: 165px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                SystemHeading { text: root.loc("system_stats"); horizontal-stretch: 1; }
                                SystemHeading {
                                    font-size: 11px;
                                    text: root.loc("system_cpu_temp") + "  "
                                        + (root.system-stats.temperature >= 0 ? round(root.system-stats.temperature) + " °C" : "—");
                                }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    width: 126px;
                                    height: 126px;
                                    for metric[index] in root.system-metrics : SystemRing {
                                        diameter: (114 - index * 22) * 1px;
                                        progress: metric.value / 100;
                                        tint: metric.tint;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    horizontal-stretch: 1;
                                    for metric in root.system-metrics : SystemDetail {
                                        title: metric.label;
                                        value: metric.value >= 0 ? round(metric.value) + "%" : metric.empty;
                                        tint: metric.tint;
                                        value-color: metric.value >= 90 ? Theme.error : metric.value >= 80 ? #ff9800 : Theme.text;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                    GlassCard {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            SystemHeading { text: root.loc("system_storage"); }
                            Rectangle {
                                height: 10px;
                                background: Theme.raised;
                                clip: true;
                                for row in root.system-storage.rows : Rectangle {
                                    x: parent.width * row.offset;
                                    width: parent.width * row.fraction;
                                    background: row.tint;
                                }
                                Rectangle {
                                    x: parent.width * max(0, root.system-storage.usage / 100 - root.system-storage.other);
                                    width: parent.width * root.system-storage.other;
                                    background: #9e9e9e;
                                    animate x, width { duration: 300ms; }
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                SystemDetail { title: root.loc("system_storage_used"); value: root.system-storage.used; }
                                SystemDetail { title: root.loc("system_storage_free"); value: root.system-storage.free; }
                                SystemDetail { title: root.loc("system_storage_total"); value: root.system-storage.total; }
                            }
                            Rectangle { height: 1px; background: Theme.raised; }
                            Scroller {
                                min-height: 0px;
                                VerticalLayout {
                                    spacing: 2px;
                                    for row in root.system-storage.rows : SystemDetail {
                                        height: 26px;
                                        title: root.loc(row.label-key);
                                        value: row.size;
                                        tint: row.tint;
                                        marker-size: 12px;
                                        marker-radius: 3px;
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    width: (root.width - 28px) / 2;
                    GlassCard {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                SystemHeading { text: root.loc("system_updates"); horizontal-stretch: 1; }
                                Md3Button {
                                    filled: true;
                                    label: root.updating-manager != "" ? root.loc("system_updates_updating") : root.loc("system_updates_update_all");
                                    enabled: root.updates-available && !root.updates-running && !root.updates-checking && root.updating-manager == "";
                                    clicked => { root.update-all(); }
                                }
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: refresh-hit.pressed ? Theme.elevated : transparent;
                                    Image {
                                        source: @image-url("icons/mdi/refresh.svg");
                                        width: 18px;
                                        height: 18px;
                                        colorize: Theme.text;
                                        transform-rotation: root.updates-checking ? 360deg * mod(animation-tick(), 900ms) / 900ms : 0deg;
                                    }
                                    accessible-role: button;
                                    accessible-label: root.loc("system_updates_refresh");
                                    refresh-hit := TouchArea {
                                        enabled: !root.updates-running && root.updating-manager == "";
                                        clicked => { root.update-refresh(); }
                                    }
                                }
                            }
                            if root.updates.length == 0 : DrawerEmpty {
                                text: root.loc("system_updates_no_state");
                                font-size: 12px;
                            }
                            if root.updates.length > 0 : Scroller {
                                min-height: 0px;
                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    for item in root.updates : Rectangle {
                                        border-radius: 12px;
                                        background: item.available ? Theme.elevated : transparent;
                                        min-height: update-content.min-height;
                                        preferred-height: update-content.preferred-height;
                                        update-content := VerticalLayout {
                                            alignment: start;
                                            padding: 3px;
                                            spacing: 3px;
                                            HorizontalLayout {
                                                min-height: item.id == "system" && item.preview != "" ? 64px : 46px;
                                                spacing: 6px;
                                                Image {
                                                    width: 18px;
                                                    height: 18px;
                                                    colorize: Theme.text;
                                                    source: item.git ? @image-url("icons/mdi/git.svg") : @image-url("icons/mdi/package-variant.svg");
                                                }
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;
                                                    HorizontalLayout {
                                                        alignment: start;
                                                        spacing: 6px;
                                                        SystemHeading { text: item.id; }
                                                        Rectangle {
                                                            width: update-status.preferred-width + 14px;
                                                            height: 20px;
                                                            border-radius: 10px;
                                                            background: item.updating ? Theme.primary : item.available ? Theme.error : Theme.raised;
                                                            update-status := Text {
                                                                text: item.updating ? root.loc("system_updates_updating")
                                                                    : item.checking ? root.loc("system_updates_checking")
                                                                    : item.available ? root.loc("system_updates_available") : root.loc("system_updates_up_to_date");
                                                                color: item.updating ? Theme.on-primary : item.available ? Theme.on-error : Theme.muted;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: item.error != "" ? item.error : item.id == "system" ? root.fill-text(root.loc("system_updates_package_count"), "{count}", item.count + "") : item.version;
                                                        color: item.error != "" ? Theme.error : Theme.muted;
                                                        font-size: 12px;
                                                        overflow: elide;
                                                    }
                                                    if item.preview != "" : Text { text: item.preview; color: Theme.muted; font-size: 12px; overflow: elide; }
                                                }
                                                Md3Button {
                                                    label: root.loc("system_updates_update");
                                                    height: 28px;
                                                    filled: true;
                                                    enabled: item.active && root.updating-manager == ""
                                                        && !(item.id == "backend" ? root.updates-running : root.backend-update-running);
                                                    clicked => { root.run-update(item.id); }
                                                }
                                            }
                                            if item.updating && (item.stage != "" || item.progress >= 0) : SystemProgress {
                                                label: root.update-stage(item.stage);
                                                value: item.progress;
                                            }
                                            if item.updating && item.package != "" : SystemProgress { label: item.package; value: item.package-progress; }
                                            if item.updating && item.message != "" : Text {
                                                text: item.message; color: Theme.muted; font-size: 10px; wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    GlassCard {
                        height: 118px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            alignment: start;
                            DrawerTitle { text: root.loc("language"); }
                            SystemLanguage {
                                language: root.language;
                                english: root.loc("english");
                                german: root.loc("german");
                                selected(code) => { root.choose-language(code); }
                            }
                        }
                    }
                }
            }
            if root.page-shown(4) : VerticalLayout {
                x: root.page-x(4);
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    SpeedMetric { width: (root.width - 40px) / 3; title: root.loc("speedtest_ping"); glyph: "◷"; value: root.speedtest-ping; active: root.speedtest-stage == "ping"; }
                    SpeedMetric { width: (root.width - 40px) / 3; title: root.loc("speedtest_download"); glyph: "↓"; value: root.speedtest-download; active: root.speedtest-stage == "download"; }
                    SpeedMetric { width: (root.width - 40px) / 3; title: root.loc("speedtest_upload"); glyph: "↑"; value: root.speedtest-upload; active: root.speedtest-stage == "upload"; }
                }
                if root.speedtest-error != "" : Text {
                    text: root.speedtest-error; color: Theme.error; font-size: 12px; wrap: word-wrap;
                }
                Md3Button {
                    height: 44px;
                    width: parent.width - 24px;
                    border-radius: 22px;
                    filled: true;
                    enabled: root.connection == "Connected" && !root.speedtest-running && !root.speedtest-starting;
                    label: root.speedtest-running ? root.loc("speedtest_running")
                        : root.speedtest-starting ? root.loc("speedtest_starting")
                        : root.loc("speedtest_run");
                    clicked => { root.speedtest-start(); }
                }
            }
            if root.connection != "Connected" : Rectangle {
                background: Theme.background;
                TouchArea {}
                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    Text {
                        text: root.loc(root.backend-ready ? "connect_connection_lost" : "connect_starting_title");
                        color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center;
                    }
                    Text {
                        text: root.loc(root.backend-ready ? "connect_connection_lost_text" : "connect_starting_text");
                        color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
                    }
                    Text {
                        text: root.backend-ready ? root.loc("connect_reconnecting") : root.startup-stage(root.language, root.backend-stage);
                        color: Theme.primary; font-size: 12px; horizontal-alignment: center;
                    }
                }
            }
        }
        // Quickshell bottom navigation: 52px, five centered pill icons.
        Rectangle {
            height: 52px;
            opacity: root.stage(0.12, 0.55);
            background: Theme.surface;
            if root.dashboard-editing : HorizontalLayout {
                width: self.preferred-width;
                height: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                spacing: 10px;
                PillButton {
                    label: root.loc("dashboard_wallpaper");
                    clicked => { root.dashboard-open-picker("wallpaper"); }
                }
                PillButton { label: root.loc("dashboard_reset"); clicked => { root.dashboard-editor-reset(); } }
            }
            if !root.dashboard-editing : HorizontalLayout {
                width: self.preferred-width;
                height: 42px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                spacing: 10px;
                NavItem { label: root.loc("page_home"); icon: @image-url("icons/mdi/home.svg"); active-icon: @image-url("icons/mdi-selected/home.svg"); active: root.page == 0; clicked => { root.go-to(0); } }
                NavItem { label: root.loc("audio"); icon: @image-url("icons/mdi/volume-high.svg"); active-icon: @image-url("icons/mdi-selected/volume-high.svg"); active: root.page == 1; clicked => { root.go-to(1); } }
                NavItem { label: root.loc("page_controls"); icon: @image-url("icons/mdi/tune.svg"); active-icon: @image-url("icons/mdi-selected/tune.svg"); active: root.page == 2; clicked => { root.go-to(2); } }
                NavItem { label: root.loc("page_system"); icon: @image-url("icons/mdi/server.svg"); active-icon: @image-url("icons/mdi-selected/server.svg"); active: root.page == 3; clicked => { root.go-to(3); if root.connection=="Connected" {root.update-refresh();} } }
                NavItem { label: root.loc("page_speedtest"); icon: @image-url("icons/mdi/speedometer.svg"); active-icon: @image-url("icons/mdi-selected/speedometer.svg"); active: root.page == 4; clicked => { root.go-to(4); } }
            }
            if root.page == 0 : Rectangle {
                width: 40px;
                height: 40px;
                x: 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 20px;
                background: root.dashboard-editing ? Theme.primary : transparent;
                Text {
                    text: root.dashboard-editing ? "✓" : "✎";
                    color: root.dashboard-editing ? Theme.on-primary : Theme.muted;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        if root.dashboard-editing {
                            // The checkmark saves; the editor closes once the save succeeds.
                            root.dashboard-save(root.edit-left-0, root.edit-left-1, root.edit-right-0, root.edit-right-1);
                        } else {
                            root.edit-left-0 = root.left-slot-0;
                            root.edit-left-1 = root.left-slot-1;
                            root.edit-right-0 = root.right-slot-0;
                            root.edit-right-1 = root.right-slot-1;
                            root.dashboard-editing = true;
                            root.dashboard-editor-open();
                        }
                    }
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                x: parent.width - self.width - 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 20px;
                Image { width: 21px; height: 21px; source: @image-url("icons/mdi/power.svg"); }
                TouchArea { clicked => { root.power-menu-open = true; } }
            }
        }
    }

    // Keep the gesture areas stationary while the sheet follows the finger.
    Rectangle {
        width: parent.width;
        height: parent.height;
        y: root.drawer-dragging
            ? clamp((root.network-drawer-open ? 0px : -self.height) + root.drawer-delta, -self.height, 0px)
            : root.network-drawer-open ? 0px : -self.height;
        animate y { duration: root.drawer-dragging ? 0ms : 190ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        visible: self.y > -self.height;
        background: Theme.background;
        TouchArea { }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    if root.ethernet.length > 0 : Md3Card {
                        height: min(max(100px, 50px + root.ethernet.length * 38px), max(100px, root.height * 0.36));
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            DrawerTitle { text: root.loc("ethernet"); }
                            Scroller {
                                VerticalLayout {
                                    spacing: 6px;
                                    for row in root.ethernet : HorizontalLayout {
                                        height: 32px;
                                        spacing: 8px;
                                        DrawerRowText {
                                            title: row.id;
                                            detail: root.connection-status(row.connected);
                                            active: row.connected;
                                        }
                                        DashboardSwitch {
                                            checked: row.enabled;
                                            enabled: !root.drawer-busy;
                                            toggled => { root.drawer-command(row.enabled ? "ethernet-off" : "ethernet-on", row.id, ""); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Md3Card {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                DrawerTitle { text: root.loc("wifi"); horizontal-stretch: 1; }
                                Md3Button {
                                    label: root.loc("saved_wifi");
                                    clicked => { root.saved-wifi-open = true; }
                                }
                                DashboardSwitch {
                                    checked: root.wifi-enabled;
                                    enabled: root.wifi-available && !root.drawer-busy;
                                    toggled => { root.drawer-command(root.wifi-enabled ? "wifi-off" : "wifi-on", "", ""); }
                                }
                            }
                            if root.drawer-network-error != "" : Text {
                                text: root.drawer-network-error;
                                color: Theme.error;
                                font-size: 11px;
                                overflow: elide;
                            }
                            if !root.wifi-enabled || root.wifi.length == 0 : DrawerEmpty {
                                text: root.wifi-enabled ? root.loc("no_wifi_networks")
                                    : root.wifi-available ? root.loc("wifi_disabled")
                                        : root.loc("wifi_unavailable");
                            }
                            if root.wifi-enabled && root.wifi.length > 0 : Scroller {
                                vertical-stretch: 1;
                                min-height: 0px;
                                VerticalLayout {
                                    spacing: 5px;
                                    for row in root.wifi : Md3Card {
                                        height: 46px;
                                        border-radius: 12px;
                                        background: row.connected ? Theme.primary-container : Theme.raised;
                                        HorizontalLayout {
                                            padding: 9px;
                                            spacing: 8px;
                                            DrawerRowText {
                                                title: row.name;
                                                detail: row.connected ? root.connection-status(true)
                                                    : row.profile != "" ? root.loc("saved") : "";
                                                active: row.connected;
                                            }
                                            Text { text: row.signal + "%"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                        }
                                        TouchArea {
                                            enabled: !root.drawer-busy;
                                            clicked => {
                                                if row.connected {
                                                    root.drawer-command("wifi-disconnect", row.device, "");
                                                } else if row.profile != "" {
                                                    root.drawer-command("wifi-saved", row.profile, "");
                                                } else if !row.secured {
                                                    root.drawer-command("wifi-connect", row.id, "");
                                                } else {
                                                    root.wifi-target = row.id;
                                                    root.wifi-name = row.name;
                                                    root.wifi-password = "";
                                                    root.touch-keyboard-open = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    Md3Card {
                        height: min(244px, max(160px, root.height - 178px));
                        VerticalLayout {
                            padding: 14px;
                            spacing: 7px;
                            HorizontalLayout {
                                spacing: 8px;
                                DrawerTitle { text: root.loc("bluetooth"); horizontal-stretch: 1; }
                                Md3Button {
                                    label: root.bluetooth-scanning ? root.loc("bluetooth_stop_scan") : root.loc("bluetooth_scan");
                                    enabled: root.bluetooth-powered && !root.bluetooth-busy;
                                    clicked => { root.drawer-command(root.bluetooth-scanning ? "bt-stop-scan" : "bt-scan", "", ""); }
                                }
                                DashboardSwitch {
                                    checked: root.bluetooth-powered;
                                    enabled: root.bluetooth-available && !root.bluetooth-busy;
                                    toggled => { root.drawer-command(root.bluetooth-powered ? "bluetooth-off" : "bluetooth-on", "", ""); }
                                }
                            }
                            Text {
                                text: !root.bluetooth-available ? root.loc("bluetooth_unavailable")
                                    : !root.bluetooth-powered ? root.loc("bluetooth_disabled")
                                    : root.bluetooth-scanning
                                        ? root.loc("bluetooth_scanning")
                                        : root.fill-text(root.fill-text(root.loc("bluetooth_device_counts"), "{paired}", root.paired-devices.length + ""), "{connected}", root.bluetooth-connected-count + "");
                                color: root.bluetooth-scanning ? Theme.primary : Theme.muted;
                                font-size: 10px;
                                max-height: 12px;
                                overflow: elide;
                            }
                            if root.bluetooth-error != "" : HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.loc(root.bluetooth-error);
                                    color: Theme.error;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Md3Button { label: "×"; height: 28px; clicked => { root.bluetooth-error = ""; } }
                            }
                            if root.bluetooth-powered && root.paired-devices.length == 0 &&
                                (!root.bluetooth-scanning || root.discovered-devices.length == 0) : DrawerEmpty {
                                text: root.bluetooth-scanning ? root.loc("bluetooth_scanning")
                                    : root.loc("bluetooth_no_paired");
                            }
                            if root.bluetooth-powered && (root.paired-devices.length > 0 ||
                                (root.bluetooth-scanning && root.discovered-devices.length > 0)) : Scroller {
                                vertical-stretch: 1;
                                min-height: 0px;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    if root.paired-devices.length > 0 : Text {
                                        text: root.loc("bluetooth_paired"); color: Theme.muted; font-size: 10px;
                                    }
                                    for row in root.paired-devices : DrawerBluetoothDevice {
                                        device: row;
                                        status: root.connection-status(row.connected);
                                        paired: true;
                                        enabled: !root.bluetooth-busy;
                                        activated => { root.drawer-command(row.connected ? "bt-disconnect" : "bt-connect", row.id, ""); }
                                        removed => { root.drawer-command("bt-remove", row.id, ""); }
                                    }
                                    if root.bluetooth-scanning && root.discovered-devices.length > 0 : Text {
                                        text: root.loc("bluetooth_discovered"); color: Theme.muted; font-size: 10px;
                                    }
                                    if root.bluetooth-scanning && root.discovered-devices.length > 0 : VerticalLayout {
                                        spacing: 6px;
                                        for row in root.discovered-devices : DrawerBluetoothDevice {
                                            device: row;
                                            status: root.bluetooth-busy && root.drawer-pairing == row.id
                                                ? root.loc("bluetooth_pairing") : root.loc("bluetooth_pair");
                                            enabled: !root.bluetooth-busy;
                                            activated => {
                                                root.drawer-pairing = row.id;
                                                root.drawer-command("bt-pair", row.id, "");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Md3Card {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            DrawerTitle { text: root.loc("web_access"); }
                            Rectangle {
                                if root.commander-url != "" : Image {
                                    width: max(0px, min(260px, min(parent.width - 8px, parent.height - 4px)));
                                    height: self.width;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.commander-qr;
                                    image-fit: contain;
                                    image-rendering: pixelated;
                                }
                            }
                            Text {
                                text: root.commander-url != "" ? root.commander-url : root.loc("no_ip");
                                color: Theme.muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: char-wrap;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 28px; }
        }
        if root.drawer-error != "" : Rectangle {
            x: 14px;
            y: parent.height - self.height - 52px;
            width: parent.width - 28px;
            height: 44px;
            border-radius: 12px;
            background: Theme.elevated;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                Text { text: root.drawer-error; color: Theme.error; font-size: 12px; vertical-alignment: center; wrap: word-wrap; overflow: elide; horizontal-stretch: 1; }
                Md3Button { label: "×"; clicked => { root.drawer-error = ""; } }
            }
        }
        if root.network-drawer-open : Rectangle {
            width: 48px;
            height: 5px;
            x: (parent.width - self.width) / 2;
            y: parent.height - (28px + self.height) / 2;
            border-radius: 3px;
            background: Theme.muted;
        }
    }
    TouchArea {
        y: 0px;
        width: parent.width;
        height: 20px;
        enabled: !root.network-drawer-open && !root.touch-keyboard-open && !root.dashboard-picker-open;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.start-drawer-drag();
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.drawer-dragging {
                root.settle-drawer(self.mouse-y - self.pressed-y, true);
            } else if event.kind == PointerEventKind.cancel && root.drawer-dragging {
                root.drawer-dragging = false;
            }
        }
        moved => { if root.drawer-dragging { root.drawer-delta = self.mouse-y - self.pressed-y; } }
    }
    TouchArea {
        y: parent.height - 28px;
        width: parent.width;
        height: 28px;
        enabled: root.network-drawer-open && !root.touch-keyboard-open;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.start-drawer-drag();
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.drawer-dragging {
                root.settle-drawer(self.pressed-y - self.mouse-y, false);
            } else if event.kind == PointerEventKind.cancel && root.drawer-dragging {
                root.drawer-dragging = false;
            }
        }
        moved => { if root.drawer-dragging { root.drawer-delta = self.mouse-y - self.pressed-y; } }
    }

    if root.network-drawer-open && root.saved-wifi-open : dialog-1 := DialogScrim {
        animated: root.gpu-effects;
        TouchArea { }
        Md3Card {
            opacity: dialog-1.progress;
            transform-scale: 0.94 + 0.06 * dialog-1.progress;
            width: min(520px, parent.width - 32px);
            height: min(parent.height - 32px, 102px + clamp(root.saved-wifi.length * 62px, 100px, 360px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                DrawerTitle { text: root.loc("saved_wifi"); }
                if root.saved-wifi.length == 0 : DrawerEmpty {
                    text: root.loc("no_saved_wifi");
                }
                if root.saved-wifi.length > 0 : Scroller {
                    vertical-stretch: 1;
                    min-height: 0px;
                    VerticalLayout {
                        spacing: 8px;
                        for row in root.saved-wifi : Md3Card {
                            height: 54px;
                            border-radius: 12px;
                            background: Theme.raised;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                DrawerRowText { title: row.name; detail: root.connection-status(row.connected); active: row.connected; }
                                Md3Button {
                                    label: root.loc("delete");
                                    enabled: !root.drawer-busy;
                                    clicked => { root.confirm-forget = row.id; root.forget-name = row.name; }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Md3Button { label: root.loc("cancel"); clicked => { root.saved-wifi-open = false; } }
                }
            }
        }
    }
    if root.network-drawer-open && root.confirm-forget != "" : dialog-2 := DialogScrim {
        animated: root.gpu-effects;
        TouchArea { }
        Md3Card {
            opacity: dialog-2.progress;
            transform-scale: 0.94 + 0.06 * dialog-2.progress;
            width: min(440px, parent.width - 32px);
            height: 148px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                DrawerTitle { text: root.loc("delete_saved_wifi"); }
                Text {
                    text: root.fill-text(root.loc("delete_saved_wifi_text"), "%1", root.forget-name);
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Md3Button { label: root.loc("cancel"); clicked => { root.confirm-forget = ""; } }
                    Md3Button {
                        label: root.loc("delete");
                        filled: true;
                        clicked => { root.drawer-command("wifi-forget", root.confirm-forget, ""); root.confirm-forget = ""; }
                    }
                }
            }
        }
    }

    if root.page == 1 && root.routing != "" : dialog-3 := DialogScrim {
        animated: root.gpu-effects;
        TouchArea { clicked => { root.routing = ""; } }
        for device in root.audio-interfaces : Rectangle {
            opacity: dialog-3.progress;
            transform-scale: 0.94 + 0.06 * dialog-3.progress;
            visible: device.routable && device.id == root.routing;
            if device.routable && device.id == root.routing : Md3Card {
                width: min(560px, parent.width - 36px);
                height: min(parent.height - 36px, 364px);
                TouchArea { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    DrawerTitle { text: device.label + " · " + root.loc("audio_outputs"); }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.loc("audio_per_link_control");
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        DashboardSwitch {
                            checked: device.per-link;
                            toggled => { root.per-link-control(device.id, !device.per-link); }
                        }
                    }
                    if device.links.length == 0 : DrawerEmpty {
                        text: root.loc("audio_no_physical_outputs");
                    }
                    if device.links.length > 0 : Scroller {
                        min-height: 0;
                        VerticalLayout {
                            alignment: start;
                            spacing: 6px;
                            for link in device.links : Md3Card {
                                height: device.per-link && link.linked && link.present ? 80px : 48px;
                                border-radius: 12px;
                                background: Theme.elevated;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Image {
                                            width: 18px;
                                            height: 18px;
                                            source: link.linked ? @image-url("icons/mdi/link-variant.svg") : @image-url("icons/mdi/link-variant-off.svg");
                                            colorize: link.linked ? Theme.primary : Theme.muted;
                                        }
                                        DrawerRowText {
                                            title: link.label;
                                            detail: !link.present ? root.loc("disconnected")
                                                : link.linked ? root.loc("audio_linked") : root.loc("audio_not_linked");
                                            active: link.linked;
                                        }
                                        if link.default-output : Text {
                                            text: "★";
                                            color: Theme.primary;
                                            vertical-alignment: center;
                                            accessible-label: root.loc("audio_default");
                                        }
                                        DashboardSwitch {
                                            checked: link.linked;
                                            toggled => { root.link-output(device.id, link.id, !link.linked); }
                                        }
                                    }
                                    if device.per-link && link.linked && link.present : HorizontalLayout {
                                        spacing: 8px;
                                        fader := AudioFader {
                                            minimum: device.minimum;
                                            maximum: device.maximum;
                                            step: device.step;
                                            value: link.volume;
                                            committed(value) => { root.link-volume(device.id, link.id, value); }
                                        }
                                        Text { text: round(fader.value * 100) + "%"; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Md3Button { label: root.loc("close"); clicked => { root.routing = ""; } }
                    }
                }
            }
        }
    }

    if root.dashboard-picker-open : dialog-4 := DialogScrim {
        animated: root.gpu-effects;
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { root.dashboard-picker-open = false; } }
        Rectangle {
            opacity: dialog-4.progress;
            transform-scale: 0.94 + 0.06 * dialog-4.progress;
            property <bool> wallpapers: root.dashboard-picker-kind == "wallpaper";
            width: self.wallpapers ? parent.width - 32px : min(parent.width - 44px, 600px);
            height: self.wallpapers ? parent.height - 32px
                : root.touch-keyboard-open ? min(parent.height - root.keyboard-height - 24px, 380px) : min(parent.height - 60px, 500px);
            x: (parent.width - self.width) / 2;
            y: root.touch-keyboard-open ? 12px : (parent.height - self.height) / 2;
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.raised;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: root.loc(root.dashboard-picker-kind == "wallpaper" ? "dashboard_wallpaper_title"
                            : root.dashboard-picker-kind == "macros" ? "dashboard_choose_macros"
                            : root.dashboard-picker-kind == "auto_macros" ? "dashboard_choose_auto_macros" : "dashboard_choose_card");
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    PillButton { min-width: 68px; label: root.loc("close"); clicked => { root.dashboard-picker-open = false; root.touch-keyboard-open = false; } }
                }
                if root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros" : HorizontalLayout {
                    spacing: 8px;
                    search-entry := KioskSearch {
                        horizontal-stretch: 1;
                        placeholder-text: root.loc("dashboard_search");
                        text <=> root.dashboard-picker-search;
                        edited(search) => { root.dashboard-filter(search); }
                        activated => { root.touch-keyboard-open = true; }
                        accepted => { root.hide-keyboard(); }
                    }
                }
                if root.wallpaper-picker-loading && root.dashboard-picker-kind == "wallpaper" : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout { alignment: center; LoadingSpinner { size: 40px; } }
                    Text { text: root.loc("dashboard_wallpaper_loading"); color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                }
                if root.dashboard-picker-kind == "wallpaper" && !root.wallpaper-picker-loading : Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        wallpaper-grid := Rectangle {
                            property <length> gap: 10px;
                            property <int> columns: max(2, floor((self.width + self.gap) / (200px + self.gap)));
                            property <length> tile-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                            property <length> tile-height: self.tile-width * 0.62;
                            height: ceil(root.dashboard-picker-items.length / self.columns) * (self.tile-height + self.gap);
                            for item[i] in root.dashboard-picker-items : Rectangle {
                                x: mod(i, wallpaper-grid.columns) * (wallpaper-grid.tile-width + wallpaper-grid.gap);
                                y: floor(i / wallpaper-grid.columns) * (wallpaper-grid.tile-height + wallpaper-grid.gap);
                                width: wallpaper-grid.tile-width;
                                height: wallpaper-grid.tile-height;
                                border-radius: 14px;
                                background: Theme.raised;
                                clip: true;
                                if item.name != "" : Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: item.thumbnail;
                                    image-fit: cover;
                                }
                                if item.name != "" && item.loading : LoadingSpinner {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2 - 15px;
                                }
                                if item.name == "" : Image {
                                    width: 32px;
                                    height: 32px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2 - 10px;
                                    source: @image-url("icons/mdi/close.svg");
                                    colorize: Theme.muted;
                                }
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: 30px;
                                    background: Theme.surface.with-alpha(0.82);
                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        text: item.name == "" ? root.loc("dashboard_wallpaper_none") : item.name;
                                        color: Theme.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    border-radius: 14px;
                                    border-width: item.selected ? 3px : wallpaper-tap.pressed ? 2px : 0px;
                                    border-color: item.selected ? Theme.primary : Theme.outline;
                                    background: wallpaper-tap.pressed ? Theme.background.with-alpha(0.3) : transparent;
                                }
                                if item.selected : Rectangle {
                                    x: parent.width - self.width - 8px;
                                    y: 8px;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: Theme.primary;
                                    Image { width: 18px; height: 18px; source: @image-url("icons/mdi/check.svg"); colorize: Theme.on-primary; }
                                }
                                wallpaper-tap := TouchArea { clicked => { root.dashboard-select-option(item.name); } }
                            }
                        }
                    }
                }
                if root.dashboard-picker-kind != "wallpaper" : Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        for item in root.dashboard-picker-items : ListTile {
                            property <bool> multi: root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros";
                            title: self.multi ? item.name : root.card-name(item.name);
                            highlighted: item.selected;
                            trailing: "check";
                            checked: item.selected;
                            clicked => { root.dashboard-select-option(item.name); }
                        }
                    }
                }
                if root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros" : HorizontalLayout {
                    Text { text: root.loc("dashboard_selection_limit"); color: Theme.muted; font-size: 11px; horizontal-stretch: 1; }
                    PillButton { label: root.loc("apply"); selected: true; min-width: 90px; clicked => { root.dashboard-apply-picker(); } }
                }
            }
        }
    }

    if root.network-drawer-open && root.wifi-target != "" : dialog-5 := DialogScrim {
        animated: root.gpu-effects;
        TouchArea { }
        Md3Card {
            opacity: dialog-5.progress;
            transform-scale: 0.94 + 0.06 * dialog-5.progress;
            width: min(parent.width - 32px, 420px);
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: root.touch-keyboard-open ? max(8px, (parent.height - root.keyboard-height - self.height) / 2)
                : (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                DrawerTitle { text: root.loc("wifi_connect"); }
                Text { text: root.wifi-name; color: Theme.muted; font-size: 13px; overflow: elide; }
                password := LineEdit {
                    text <=> root.wifi-password;
                    placeholder-text: root.loc("wifi_password_hint");
                    input-type: InputType.password;
                    accepted => { root.submit-wifi-password(); }
                    changed has-focus => { if self.has-focus { root.touch-keyboard-open = true; } }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Md3Button { label: root.loc("cancel"); clicked => { root.close-wifi-password(); } }
                    Md3Button {
                        label: root.loc("connect");
                        filled: true;
                        enabled: root.wifi-password != "" && !root.drawer-busy;
                        clicked => { root.submit-wifi-password(); }
                    }
                }
            }
            init => { password.focus(); }
        }
    }
    // Fit the keys to the keyboard surface, including its optional symbols row.
    if (root.dashboard-picker-open || root.wifi-target != "" || root.page == 2) && root.touch-keyboard-open : Rectangle {
        x: 0px;
        width: root.width;
        height: root.keyboard-height;
        y: root.height - self.height;
        clip: true;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.elevated;
        // Keyboard surface eats touches so nav controls cannot fire underneath.
        TouchArea { }
        VerticalLayout {
            padding: 6px;
            spacing: 5px;
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                for key in (root.touch-keyboard-symbols ? ["1","2","3","4","5","6","7","8","9","0"] : ["q","w","e","r","t",root.language == "de" ? "z" : "y","u","i","o","p"]) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => {
                        root.keyboard-input(self.label);
                        root.touch-keyboard-shift = false;
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                Rectangle { width: 18px; background: transparent; }
                for key in (root.touch-keyboard-symbols ? ["@","#","$","%","&","-","+","(",")","/"] : (root.language == "de" ? ["a","s","d","f","g","h","j","k","l","ö"] : ["a","s","d","f","g","h","j","k","l"])) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => { root.keyboard-input(self.label); root.touch-keyboard-shift = false; }
                }
                Rectangle { width: 18px; background: transparent; }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                TouchKey { width: 58px; accent: true; label: "⇧"; clicked => { root.touch-keyboard-shift = !root.touch-keyboard-shift; } }
                for key in (root.touch-keyboard-symbols ? ["*","\"","'",";",":","!","?","=","_","\\"] : (root.language == "de" ? ["y","x","c","v","b","n","m","ä","ü"] : ["z","x","c","v","b","n","m"])) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => { root.keyboard-input(self.label); root.touch-keyboard-shift = false; }
                }
                TouchKey { width: 58px; accent: true; label: "⌫"; clicked => { root.keyboard-input("backspace"); } }
            }
            if root.touch-keyboard-symbols : HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                for key in ["{", "}", "<", ">", "^", "~", "`", "|"] : TouchKey {
                    horizontal-stretch: 1;
                    label: key;
                    clicked => { root.keyboard-input(key); }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;
                TouchKey { width: 64px; accent: true; label: root.touch-keyboard-symbols ? "ABC" : "?123"; clicked => { root.touch-keyboard-symbols = !root.touch-keyboard-symbols; } }
                TouchKey { width: 48px; label: root.touch-keyboard-symbols ? "[" : ","; clicked => { root.keyboard-input(self.label); } }
                TouchKey { horizontal-stretch: 1; label: root.touch-keyboard-symbols ? root.loc("keyboard_symbols") : root.loc(root.language == "de" ? "german" : "english"); clicked => { root.keyboard-input(" "); } }
                TouchKey { width: 48px; label: root.touch-keyboard-symbols ? "]" : "."; clicked => { root.keyboard-input(self.label); } }
                TouchKey { width: 58px; accent: true; label: "⌄"; clicked => { root.hide-keyboard(); } }
            }
        }
    }

    if root.osd-visible && root.page != 1 && !root.network-drawer-open && !root.dashboard-editing && !root.touch-keyboard-open : Rectangle {
        y: parent.height - self.height - 60px; x: (parent.width - self.width)/2;
        width: min(520px,parent.width); height: 58px; border-radius: 16px; background: Theme.raised;
        HorizontalLayout { padding: 6px; spacing: 8px;
            Text { text: root.osd-item.label; color: Theme.text; vertical-alignment: center; }
            PillButton { min-width: 74px; label: root.osd-item.muted ? root.loc("audio_unmute") : root.loc("audio_mute"); clicked => {root.change-volume(root.osd-item,root.osd-item.muted ? root.osd-item.restore : 0,true);} }
            Slider { minimum: root.osd-item.minimum; maximum: root.osd-item.maximum; value: root.osd-item.volume; released(v) => {root.change-volume(root.osd-item,v,false);} }
            PillButton { width: 40px; label: "×"; clicked => {root.osd-visible=false;} }
        }
    }
    // Modal is on the root layer, above navigation and the drawer.
    if root.power-menu-open : dialog-6 := DialogScrim {
        animated: root.gpu-effects;
        width: parent.width;
        height: parent.height;
        dim: 0.6;
        TouchArea { clicked => { root.power-menu-open = false; } }
        Rectangle {
            opacity: dialog-6.progress;
            transform-scale: 0.94 + 0.06 * dialog-6.progress;
            width: min(parent.width - 40px, 440px);
            height: 378px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 22px;
            background: Theme.surface;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text { text: root.loc("power_menu"); font-size: 22px; font-weight: 600; color: Theme.text; }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/power-standby.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: root.loc("shutdown_device"); color: Theme.text; font-size: 15px; } Text { text: root.loc("shutdown_device_text"); color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("poweroff"); } }
                }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/restart.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: root.loc("restart_device"); color: Theme.text; font-size: 15px; } Text { text: root.loc("restart_device_text"); color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("reboot"); } }
                }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/server.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: root.loc("restart_backend"); color: Theme.text; font-size: 15px; } Text { text: root.loc("restart_backend_text"); color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("restart-backend"); } }
                }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; background: transparent; } PillButton { min-width: 108px; label: root.loc("cancel"); clicked => { root.power-menu-open = false; } } }
            }
        }
    }
}
