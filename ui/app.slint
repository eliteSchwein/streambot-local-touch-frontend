                        Text { text: root.speedtest-summary; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                        PillButton { width: 180px; label: "Start speedtest"; selected: true; clicked => { root.speedtest-start(); } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }
            if root.connection != "Connected" : Rectangle {
                background: Theme.background;
                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    Text { text: "Connecting to Streambot"; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: root.connection; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
                    Text { text: root.backend-stage; color: Theme.primary; font-size: 12px; horizontal-alignment: center; }
                }
            }
        }
        // Quickshell bottom navigation: 52px, five centered pill icons.
        Rectangle {
            height: 52px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 0px;
                Rectangle {
                    width: 50px;
                    background: transparent;
                    if root.page == 0 : Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: root.dashboard-editing ? Theme.primary : transparent;
                        Text {
                            text: root.dashboard-editing ? "✓" : "✎";
                            color: root.dashboard-editing ? Theme.on-primary : Theme.muted;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { if !root.dashboard-editing {
                            root.edit-left-0 = root.left-slot-0; root.edit-left-1 = root.left-slot-1;
                            root.edit-right-0 = root.right-slot-0; root.edit-right-1 = root.right-slot-1;
                        }
                        root.dashboard-editing = !root.dashboard-editing; if root.dashboard-editing { root.dashboard-editor-open(); } } }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                NavItem { icon: @image-url("icons/mdi/home.svg"); active-icon: @image-url("icons/mdi-selected/home.svg"); active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { icon: @image-url("icons/mdi/volume-high.svg"); active-icon: @image-url("icons/mdi-selected/volume-high.svg"); active: root.page == 1; clicked => { root.page = 1; root.dashboard-editing = false; } }
                NavItem { icon: @image-url("icons/mdi/tune.svg"); active-icon: @image-url("icons/mdi-selected/tune.svg"); active: root.page == 2; clicked => { root.page = 2; root.dashboard-editing = false; } }
                NavItem { icon: @image-url("icons/mdi/server.svg"); active-icon: @image-url("icons/mdi-selected/server.svg"); active: root.page == 3; clicked => { root.page = 3; root.dashboard-editing = false; } }
                NavItem { icon: @image-url("icons/mdi/speedometer.svg"); active-icon: @image-url("icons/mdi-selected/speedometer.svg"); active: root.page == 4; clicked => { root.page = 4; root.dashboard-editing = false; } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px; background: transparent;
                    Image { width: 21px; height: 21px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("icons/mdi/power.svg"); }
                    TouchArea { clicked => { root.power-menu-open = true; } }
                }
            }
        }
    }

    // Quickshell-style top-edge swipe. The visible grip also opens on tap.
    Rectangle {
        width: parent.width;
        height: 26px;
        background: transparent;
        Rectangle {
            width: 72px;
            height: 5px;
            x: (parent.width - self.width) / 2;
            y: 5px;
            border-radius: 3px;
            background: Theme.muted;
            opacity: 0.8;
        }
        top-grip := TouchArea {
            clicked => { root.network-drawer-open = true; root.refresh-drawer(); }
            moved => {
                if self.pressed && self.mouse-y - self.pressed-y > 24px {
                    root.network-drawer-open = true;
                    root.refresh-drawer();
                }
            }
        }
    }

    if root.network-drawer-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #bb000000;
        TouchArea { clicked => { root.network-drawer-open = false; } }
        Rectangle {
            width: parent.width;
            height: parent.height - 34px;
            background: Theme.background;
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: "Connection & devices"; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    PillButton { label: "Refresh"; width: 90px; clicked => { root.refresh-drawer(); } }
                    PillButton { label: "Close"; width: 90px; clicked => { root.network-drawer-open = false; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            Text { text: "Network / Wi-Fi"; font-size: 18px; font-weight: 600; color: Theme.text; }
                            Text { text: root.drawer-network; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                PillButton { horizontal-stretch: 1; label: "Wi-Fi on"; clicked => { root.drawer-command("wifi-on"); } }
                                PillButton { horizontal-stretch: 1; label: "Wi-Fi off"; clicked => { root.drawer-command("wifi-off"); } }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            Text { text: "Bluetooth"; font-size: 18px; font-weight: 600; color: Theme.text; }
                            Text { text: root.drawer-bluetooth; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                PillButton { horizontal-stretch: 1; label: "Bluetooth on"; clicked => { root.drawer-command("bluetooth-on"); } }
                                PillButton { horizontal-stretch: 1; label: "Bluetooth off"; clicked => { root.drawer-command("bluetooth-off"); } }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
                PillButton { width: 240px; label: "Power options"; clicked => { root.network-drawer-open = false; root.power-menu-open = true; } }
            }
        }
    }

    if root.dashboard-picker-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #aa000000;
        TouchArea { clicked => { root.dashboard-picker-open = false; } }
        Rectangle {
            width: min(parent.width - 44px, 600px);
            height: root.touch-keyboard-open ? min(parent.height - 242px, 380px) : min(parent.height - 60px, 500px);
            x: (parent.width - self.width) / 2;
            y: root.touch-keyboard-open ? 12px : (parent.height - self.height) / 2;
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.raised;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: root.dashboard-picker-kind == "wallpaper" ? "Choose wallpaper" : root.dashboard-picker-kind == "macros" ? "Choose macros (up to 4)" : root.dashboard-picker-kind == "auto_macros" ? "Choose auto macros (up to 4)" : "Choose dashboard card";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    PillButton { width: 68px; label: "Close"; clicked => { root.dashboard-picker-open = false; root.touch-keyboard-open = false; } }
                }
                if root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros" : HorizontalLayout {
                    spacing: 8px;
                    search-entry := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Search...";
                        text <=> root.dashboard-picker-search;
                        edited(search) => { root.dashboard-filter(search); }
                        changed has-focus => {
                            if self.has-focus { root.touch-keyboard-open = true; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for item[i] in root.dashboard-picker-items : Rectangle {
                            height: root.dashboard-picker-kind == "wallpaper" ? 90px : 46px;
                            background: item.selected ? Theme.elevated : transparent;
                            border-radius: 10px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                if root.dashboard-picker-kind == "wallpaper" : Rectangle {
                                    width: 122px;
                                    height: 72px;
                                    border-radius: 8px;
                                    background: Theme.raised;
                                    clip: true;
                                    Image { source: item.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                Text { text: item.name; color: Theme.text; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                if root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros" : Text {
                                    text: item.selected ? "☑" : "□";
                                    color: Theme.primary;
                                    font-size: 20px;
                                    vertical-alignment: center;
                                }
                                if root.dashboard-picker-kind == "wallpaper" && item.selected : Text { text: "✓"; color: Theme.primary; font-size: 18px; }
                            }
                            TouchArea { clicked => { root.dashboard-select-option(item.name); } }
                        }
                    }
                }
                if root.dashboard-picker-kind == "macros" || root.dashboard-picker-kind == "auto_macros" : HorizontalLayout {
                    Text { text: "Choose at most four items"; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; }
                    PillButton { label: "Apply"; selected: true; width: 90px; clicked => { root.dashboard-apply-picker(); } }
                }
            }
        }
    }

    // Md3Keyboard: automatic on search focus, in-process, German QWERTZ.
    if root.dashboard-picker-open && root.touch-keyboard-open : Rectangle {
        width: parent.width;
        height: root.touch-keyboard-symbols ? min(300px, parent.height * 0.50) : min(250px, parent.height * 0.42);
        y: parent.height - self.height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.elevated;
        // Keyboard surface eats touches so nav controls cannot fire underneath.
        TouchArea { }
        VerticalLayout {
            padding: 6px;
            spacing: 5px;
            HorizontalLayout {
                spacing: 4px;
                for key in (root.touch-keyboard-symbols ? ["1","2","3","4","5","6","7","8","9","0"] : ["q","w","e","r","t","z","u","i","o","p"]) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => {
                        root.keyboard-input(self.label);
                        root.touch-keyboard-shift = false;
                    }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle { width: 18px; background: transparent; }
                for key in (root.touch-keyboard-symbols ? ["@","#","$","%","&","-","+","(",")","/"] : ["a","s","d","f","g","h","j","k","l","ö"]) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => { root.keyboard-input(self.label); root.touch-keyboard-shift = false; }
                }
                Rectangle { width: 18px; background: transparent; }
            }
            HorizontalLayout {
                spacing: 4px;
                TouchKey { width: 58px; accent: true; label: "⇧"; clicked => { root.touch-keyboard-shift = !root.touch-keyboard-shift; } }
                for key in (root.touch-keyboard-symbols ? ["*","\"","'",";",":","!","?","=","_","\\"] : ["y","x","c","v","b","n","m","ä","ü"]) : TouchKey {
                    horizontal-stretch: 1;
                    label: root.touch-keyboard-shift && !root.touch-keyboard-symbols ? key.to-uppercase() : key;
                    clicked => { root.keyboard-input(self.label); root.touch-keyboard-shift = false; }
                }
                TouchKey { width: 58px; accent: true; label: "⌫"; clicked => { root.keyboard-input("backspace"); } }
            }
            if root.touch-keyboard-symbols : HorizontalLayout {
                spacing: 4px;
                for key in ["{", "}", "<", ">", "^", "~", "`", "|"] : TouchKey {
                    horizontal-stretch: 1;
                    label: key;
                    clicked => { root.keyboard-input(key); }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                TouchKey { width: 64px; accent: true; label: root.touch-keyboard-symbols ? "ABC" : "?123"; clicked => { root.touch-keyboard-symbols = !root.touch-keyboard-symbols; } }
                TouchKey { width: 48px; label: root.touch-keyboard-symbols ? "[" : ","; clicked => { root.keyboard-input(self.label); } }
                TouchKey { horizontal-stretch: 1; label: root.touch-keyboard-symbols ? "Symbols" : "Deutsch"; clicked => { root.keyboard-input(" "); } }
                TouchKey { width: 48px; label: root.touch-keyboard-symbols ? "]" : "."; clicked => { root.keyboard-input(self.label); } }
                TouchKey { width: 58px; accent: true; label: "⌄"; clicked => { root.touch-keyboard-open = false; } }
            }
        }
    }

    // Modal is on the root layer, above navigation and the drawer.
    if root.power-menu-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #cc000000;
        TouchArea { clicked => { root.power-menu-open = false; } }
        Rectangle {
            width: min(parent.width - 40px, 440px);
            height: 378px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 22px;
            background: Theme.surface;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text { text: "Power menu"; font-size: 22px; font-weight: 600; color: Theme.text; }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/power-standby.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: "Shutdown device"; color: Theme.text; font-size: 15px; } Text { text: "Turn off the Raspberry Pi"; color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("poweroff"); } }
                }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/restart.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: "Restart device"; color: Theme.text; font-size: 15px; } Text { text: "Reboot the Raspberry Pi"; color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("reboot"); } }
                }
                Rectangle {
                    height: 74px; background: Theme.elevated; border-radius: 14px;
                    HorizontalLayout { padding: 12px; spacing: 12px;
                        Image { source: @image-url("icons/mdi/server.svg"); width: 36px; height: 36px; }
                        VerticalLayout { Text { text: "Restart backend"; color: Theme.text; font-size: 15px; } Text { text: "Restart stream-overlord.service"; color: Theme.muted; font-size: 11px; } }
                    }
                    TouchArea { clicked => { root.power-action("restart-backend"); } }
                }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; background: transparent; } PillButton { width: 108px; label: "Cancel"; clicked => { root.power-menu-open = false; } } }
            }
        }
    }
}
