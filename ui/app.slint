import { Theme } from "theme.slint";
import { ActionRow, AudioEntry, AutoMacroEntry, BatteryDetails, BluetoothRow, ChannelPointRow, DashboardMacroEntry, DiagnosticRow, EthernetRow, InteractionEntry, PickerEntry, ProcessUsage, RendererInfo, SavedWifiRow, SystemStats, SystemStorage, UpdateEntry, WifiRow } from "types.slint";
import { DashboardPage, DashboardFeedback } from "pages/dashboard.slint";
import { AudioPage } from "pages/audio.slint";
import { ControlsPage } from "pages/controls.slint";
import { SystemPage } from "pages/system.slint";
import { SpeedtestPage } from "pages/speedtest.slint";
import { DevPage } from "pages/dev.slint";
import { ConnectionOverlay, BottomNavigation } from "components/navigation.slint";
import { NetworkDrawer, WifiPasswordDialog } from "components/network-drawer.slint";
import { AudioRoutingDialog, VolumeOsd } from "components/audio-overlays.slint";
import { DashboardPicker } from "components/dashboard-picker.slint";
import { TouchKeyboard } from "components/touch-keyboard.slint";
import { PowerMenu } from "components/power-menu.slint";
import { BatteryDialog } from "components/battery-dialog.slint";

// Re-exported so the generated Rust API keeps these names.
export { Theme } from "theme.slint";
export { BatteryDetails, DiagnosticRow, ProcessUsage, RendererInfo } from "types.slint";
export { EthernetRow, WifiRow, SavedWifiRow, BluetoothRow, ActionRow, ChannelPointRow, SystemStats, StorageEntry, SystemStorage, UpdateEntry, AudioLink, AudioEntry, InteractionEntry, DashboardMacroEntry, AutoMacroEntry, PickerEntry } from "types.slint";

export component App inherits Window {
    title: "Streambot Touch";
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 700px;
    min-height: 450px;
    background: Theme.background;

    in-out property <int> page: 0;
    in property <bool> dev-page-enabled;
    in property <RendererInfo> renderer-info;
    in property <[DiagnosticRow]> device-diagnostics;
    callback sample-dev-usage(bool) -> ProcessUsage;
    in-out property <string> connection: "Waiting for backend";
    in-out property <string> backend-stage: "";
    in-out property <float> backend-progress;
    in-out property <bool> backend-ready;
    pure callback locale-text(string, string) -> string;
    pure callback fill-text(string, string, string) -> string;
    pure callback startup-stage(string, string) -> string;
    in-out property <string> detail: "";
    in-out property <string> track;
    in-out property <string> music-state: "";
    in-out property <string> interaction-summary;
    in-out property <SystemStats> system-stats: { cpu: -1, temperature: -1, ram: -1, swap: -1, has-swap: false, storage: -1 };
    in-out property <SystemStorage> system-storage: { used: "—", free: "—", total: "—", usage: -1, other: 0, rows: [] };
    in-out property <bool> updates-available;
    in-out property <bool> updates-checking;
    in-out property <bool> updates-running;
    in-out property <bool> backend-update-running;
    in-out property <string> speedtest-stage: "idle";
    in-out property <string> speedtest-ping: "—";
    in-out property <string> speedtest-download: "—";
    in-out property <string> speedtest-upload: "—";
    in-out property <string> speedtest-error;
    in-out property <bool> speedtest-starting;
    callback speedtest-status();
    in-out property <[string]> macros: [];
    in-out property <[ActionRow]> auto-macros: [];
    in-out property <[ChannelPointRow]> channel-points: [];
    pure callback filter-names([string], string) -> [string];
    pure callback filter-rows([ActionRow], string) -> [ActionRow];
    pure callback filter-points([ChannelPointRow], string) -> [ChannelPointRow];
    property <[string]> shown-macros: root.filter-names(root.macros, root.search);
    property <[ActionRow]> shown-auto-macros: root.filter-rows(root.auto-macros, root.search);
    property <[ChannelPointRow]> shown-channel-points: root.filter-points(root.channel-points, root.search);
    in-out property <[AudioEntry]> audio-interfaces: [];
    in-out property <string> search: "";
    in-out property <int> macro-tab: 0;
    in-out property <string> feedback: "";
    in-out property <bool> dashboard-editing: false;
    in-out property <string> left-slot-0: "interactions";
    in-out property <string> left-slot-1: "auto_macros";
    in-out property <string> right-slot-0: "music";
    in-out property <string> right-slot-1: "";
    in-out property <string> edit-left-0: "interactions";
    in-out property <string> edit-left-1: "auto_macros";
    in-out property <string> edit-right-0: "music";
    in-out property <string> edit-right-1: "";
    in-out property <bool> power-menu-open: false;
    in-out property <bool> power-details-open;
    in property <int> battery-percent: -1;
    in property <bool> battery-charging;
    in property <BatteryDetails> battery-details: { state: 0, minutes: 0, watts: -1, health: -1 };
    in property <[float]> battery-history;
    in property <[string]> power-profiles;
    in property <string> active-power-profile;
    in-out property <bool> power-profile-busy;
    in property <bool> power-profile-failed;
    in property <string> power-profile-error;
    callback power-details-visibility(bool);
    callback choose-power-profile(string);
    changed power-menu-open => {
        if root.power-menu-open { root.power-details-open = false; }
    }
    changed power-details-open => {
        root.power-details-visibility(root.power-details-open);
    }
    in-out property <bool> network-drawer-open: false;
    property <string> wifi-name;
    in-out property <string> drawer-network-error;
    in-out property <string> drawer-error;
    in-out property <bool> wifi-enabled;
    in-out property <bool> wifi-available;
    in-out property <bool> bluetooth-available;
    in-out property <bool> bluetooth-powered;
    in-out property <bool> bluetooth-scanning;
    in-out property <bool> bluetooth-busy;
    in-out property <bool> bluetooth-refreshing;
    in-out property <string> bluetooth-error;
    in-out property <int> bluetooth-connected-count;
    in-out property <bool> touch-keyboard-open: false;
    in-out property <bool> touch-keyboard-shift: false;
    in-out property <bool> touch-keyboard-symbols: false;
    callback drawer-visibility(bool);
    callback drawer-command(string,string,string);
    in-out property <bool> drawer-busy;
    in-out property <bool> drawer-refreshing;
    in-out property <[WifiRow]> wifi;
    in-out property <[EthernetRow]> ethernet;
    in-out property <[SavedWifiRow]> saved-wifi;
    in-out property <[BluetoothRow]> paired-devices;
    in-out property <[BluetoothRow]> discovered-devices;
    in-out property <string> commander-url;
    in-out property <image> commander-qr;
    in-out property <string> wifi-target;
    in-out property <string> wifi-password;
    changed network-drawer-open => {
        if !root.network-drawer-open {
            if root.wifi-target != "" { root.close-wifi-password(); }
        }
        root.drawer-visibility(root.network-drawer-open);
    }
    function close-wifi-password() {
        root.touch-keyboard-open = false;
        root.wifi-target = "";
        root.wifi-password = "";
    }
    function submit-wifi-password() {
        if root.wifi-password != "" && !root.drawer-busy {
            root.drawer-command("wifi-connect", root.wifi-target, root.wifi-password);
            root.close-wifi-password();
        }
    }
    in-out property <string> language: "en";
    callback choose-language(string);
    pure function loc(key: string) -> string { return root.locale-text(root.language, key); }
    // While editing, the dashboard previews the draft layout in place.
    property <string> view-left-0: root.dashboard-editing ? root.edit-left-0 : root.left-slot-0;
    property <string> view-left-1: root.dashboard-editing ? root.edit-left-1 : root.left-slot-1;
    property <string> view-right-0: root.dashboard-editing ? root.edit-right-0 : root.right-slot-0;
    property <string> view-right-1: root.dashboard-editing ? root.edit-right-1 : root.right-slot-1;
    callback keyboard-input(string);
    callback dashboard-save(string, string, string, string);
    callback power-action(string);
    in-out property <bool> dashboard-picker-open: false;
    in-out property <bool> wallpaper-picker-loading;
    callback wallpaper-picker-closed();
    // The visualizer stream is only needed while a music card is on screen.
    out property <bool> music-visible: root.page == 0
        && (root.view-left-0 == "music" || root.view-left-1 == "music"
            || root.view-right-0 == "music" || root.view-right-1 == "music");
    callback music-visible-changed(bool);
    changed music-visible => { root.music-visible-changed(self.music-visible); }
    function toggle-dashboard-editor() {
        if root.dashboard-editing {
            // The editor closes once the save succeeds.
            root.dashboard-save(root.edit-left-0, root.edit-left-1, root.edit-right-0, root.edit-right-1);
        } else {
            root.edit-left-0 = root.left-slot-0;
            root.edit-left-1 = root.left-slot-1;
            root.edit-right-0 = root.right-slot-0;
            root.edit-right-1 = root.right-slot-1;
            root.dashboard-editing = true;
            root.dashboard-editor-open();
        }
    }
    changed dashboard-picker-open => {
        if !root.dashboard-picker-open {
            root.touch-keyboard-open = false;
            if root.dashboard-picker-kind == "wallpaper" {
                root.wallpaper-picker-closed();
                root.dashboard-picker-items = [];
            }
        }
    }
    // Motion: enabled from Rust only when rendering through Vulkan.
    in-out property <bool> gpu-effects: false;
    property <bool> connection-overlay-shown: root.connection != "Connected";
    property <bool> intro-running: false;
    property <duration> intro-start;
    property <bool> page-running: false;
    property <duration> page-start;
    // 0 → 1 over the startup animation / a page switch; 1 when idle.
    // animation-tick() is only read while running, so idle frames stay idle.
    property <float> intro: root.intro-running && !root.connection-overlay-shown
        ? clamp((animation-tick() - root.intro-start) / 1100ms, 0, 1) : 1;
    property <float> page-reveal: root.page-running
        ? root.ease-out(clamp((animation-tick() - root.page-start) / 340ms, 0, 1)) : 1;
    pure function ease-out(t: float) -> float { return 1 - pow(1 - t, 3); }
    // Eased progress of an intro stage running from `from` to `to` (fractions of the intro).
    pure function stage(from: float, to: float) -> float {
        return root.ease-out(clamp((root.intro - from) / (to - from), 0, 1));
    }
    function start-intro() {
        root.intro-start = animation-tick();
        root.intro-running = true;
    }
    public function enable-gpu-effects() {
        if root.gpu-effects { return; }
        root.gpu-effects = true;
        // The backend may have connected before the renderer draws its first frame.
        if !root.connection-overlay-shown { root.start-intro(); }
    }
    changed connection-overlay-shown => {
        if root.connection-overlay-shown {
            root.intro-running = false;
        } else if root.gpu-effects {
            root.start-intro();
        }
    }
    motion-timer := Timer {
        interval: 100ms;
        running: root.intro-running || root.page-running;
        triggered => {
            if root.intro-running && animation-tick() - root.intro-start > 1150ms { root.intro-running = false; }
            if root.page-running && animation-tick() - root.page-start > 380ms { root.page-running = false; }
        }
    }
    // Swipe between pages: the outgoing page stays alive until the swipe ends.
    property <int> previous-page: 0;
    function go-to(target: int) {
        if target == root.page || (target == 5 && !root.dev-page-enabled) { return; }
        if root.gpu-effects {
            root.previous-page = root.page;
            root.page-start = animation-tick();
            root.page-running = true;
        }
        root.page = target;
    }
    pure function page-shown(index: int) -> bool {
        return root.page == index || (root.page-running && root.previous-page == index);
    }
    // Pages to the right of the current one enter from the right, and vice versa.
    pure function page-x(index: int) -> length {
        if !root.page-running || root.previous-page == root.page { return 0px; }
        let direction = root.page > root.previous-page ? 1 : -1;
        return index == root.page
            ? (1 - root.page-reveal) * content-area.width * direction
            : -root.page-reveal * content-area.width * direction;
    }
    changed page => {
        root.touch-keyboard-open = false;
        root.routing = "";
        if root.page == 4 && root.connection == "Connected" { root.speedtest-status(); }
    }
    changed dev-page-enabled => {
        if !root.dev-page-enabled && root.page == 5 {
            root.go-to(0);
        }
    }
    property <length> keyboard-height: root.touch-keyboard-symbols
        ? min(300px, root.height * 0.50) : min(250px, root.height * 0.42);
    function hide-keyboard() {
        root.touch-keyboard-open = false;
        keyboard-dismiss-focus.focus();
    }
    keyboard-dismiss-focus := FocusScope { width: 0px; height: 0px; }
    in-out property <string> dashboard-picker-kind: "";
    in-out property <string> dashboard-picker-search: "";
    in-out property <[PickerEntry]> dashboard-picker-items: [];
    in-out property <int> dashboard-selected-macros;
    in-out property <int> dashboard-selected-auto-macros;
    in-out property <image> wallpaper-image;
    in-out property <string> wallpaper-label;
    in-out property <[DashboardMacroEntry]> dashboard-macro-list: [];
    callback dashboard-open-picker(string);
    callback dashboard-filter(string);
    callback dashboard-select-option(string);
    callback dashboard-apply-picker();
    callback dashboard-editor-open();
    callback dashboard-editor-reset();

    in-out property <bool> show-dashboard-macros: false;
    in-out property <[InteractionEntry]> dashboard-interactions: [];
    in-out property <[AutoMacroEntry]> dashboard-auto-macros: [];
    in-out property <string> music-title;
    in-out property <string> music-artist;
    in-out property <bool> music-playing: false;
    in-out property <bool> music-shuffle: false;
    in-out property <bool> music-loop: false;
    in-out property <bool> music-song-requests: false;
    in-out property <float> music-progress: 0;
    in-out property <string> music-position: "0:00";
    in-out property <string> music-duration: "0:00";
    in-out property <[float]> cava-bars: [0, 0, 0, 0, 0];

    callback remove-interaction(string);
    callback trigger-macro(string);
    callback toggle-auto-macro(string,bool);
    callback toggle-channel-point(string);
    callback music-action(string);
    callback speedtest-start();
    callback update-refresh();
    callback change-volume(AudioEntry,float,bool);
    callback link-output(string,string,bool);
    callback per-link-control(string,bool);
    callback link-volume(string,string,float);
    callback run-update(string);
    callback update-all();
    callback advance-updates();
    callback cancel-updates();
    in-out property <string> updating-manager;
    in-out property <bool> osd-visible;
    in-out property <int> osd-revision;
    in-out property <AudioEntry> osd-item;
    in-out property <[UpdateEntry]> updates;
    in-out property <string> routing;
    in-out property <string> theme-wallpaper;
    in-out property <bool> speedtest-running;
    pure callback matches(string,string) -> bool;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.wallpaper-image;
        image-fit: cover;
        opacity: root.stage(0, 0.5);
        transform-scale: 1.08 - 0.08 * root.stage(0, 0.9);
    }
    VerticalLayout {
        spacing: 0px;
        content-area := Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;
            if root.page-shown(0) : DashboardPage {
                x: root.page-x(0);
                width: parent.width;
                height: parent.height;
                connection: root.connection;
                dashboard-editing: root.dashboard-editing;
                view-left-0: root.view-left-0;
                view-left-1: root.view-left-1;
                view-right-0: root.view-right-0;
                view-right-1: root.view-right-1;
                dashboard-selected-macros: root.dashboard-selected-macros;
                dashboard-selected-auto-macros: root.dashboard-selected-auto-macros;
                dashboard-macro-list: root.dashboard-macro-list;
                dashboard-interactions: root.dashboard-interactions;
                dashboard-auto-macros: root.dashboard-auto-macros;
                music-title: root.music-title;
                music-artist: root.music-artist;
                music-playing: root.music-playing;
                music-shuffle: root.music-shuffle;
                music-loop: root.music-loop;
                music-song-requests: root.music-song-requests;
                music-progress: root.music-progress;
                music-position: root.music-position;
                music-duration: root.music-duration;
                cava-bars: root.cava-bars;
                fill-text(text, marker, value) => { return root.fill-text(text, marker, value); }
                dashboard-open-picker(kind) => { root.dashboard-open-picker(kind); }
                remove-interaction(uuid) => { root.remove-interaction(uuid); }
                trigger-macro(name) => { root.trigger-macro(name); }
                toggle-auto-macro(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                music-action(action) => { root.music-action(action); }
                loc(key) => { return root.loc(key); }
                stage(from, to) => { return root.stage(from, to); }
            }
            if root.page == 0 && root.dashboard-editing && root.feedback != "" : DashboardFeedback {
                x: (parent.width - self.width) / 2;
                available-width: parent.width;
                feedback: root.feedback;
            }
            if root.page-shown(1) : AudioPage {
                x: root.page-x(1);
                width: parent.width;
                height: parent.height;
                connection: root.connection;
                audio-interfaces: root.audio-interfaces;
                open-routing(id) => { root.routing = id; }
                change-volume(item, value, mute) => { root.change-volume(item, value, mute); }
                loc(key) => { return root.loc(key); }
            }
            if root.page-shown(2) : ControlsPage {
                x: root.page-x(2);
                width: parent.width;
                height: parent.height;
                connection: root.connection;
                shown-macros: root.shown-macros;
                shown-auto-macros: root.shown-auto-macros;
                shown-channel-points: root.shown-channel-points;
                search <=> root.search;
                macro-tab <=> root.macro-tab;
                touch-keyboard-open <=> root.touch-keyboard-open;
                keyboard-height: root.keyboard-height;
                trigger-macro(name) => { root.trigger-macro(name); }
                toggle-auto-macro(name, enabled) => { root.toggle-auto-macro(name, enabled); }
                toggle-channel-point(id) => { root.toggle-channel-point(id); }
                loc(key) => { return root.loc(key); }
                hide-keyboard => { root.hide-keyboard(); }
            }
            if root.page-shown(3) : SystemPage {
                x: root.page-x(3);
                width: parent.width;
                height: parent.height;
                system-stats: root.system-stats;
                system-storage: root.system-storage;
                updates-available: root.updates-available;
                updates-checking: root.updates-checking;
                updates-running: root.updates-running;
                backend-update-running: root.backend-update-running;
                language: root.language;
                updating-manager: root.updating-manager;
                updates: root.updates;
                fill-text(text, marker, value) => { return root.fill-text(text, marker, value); }
                choose-language(code) => { root.choose-language(code); }
                update-refresh => { root.update-refresh(); }
                run-update(manager) => { root.run-update(manager); }
                update-all => { root.update-all(); }
                loc(key) => { return root.loc(key); }
            }
            if root.page-shown(4) : SpeedtestPage {
                x: root.page-x(4);
                width: parent.width;
                height: parent.height;
                connection: root.connection;
                speedtest-stage: root.speedtest-stage;
                speedtest-ping: root.speedtest-ping;
                speedtest-download: root.speedtest-download;
                speedtest-upload: root.speedtest-upload;
                speedtest-error: root.speedtest-error;
                speedtest-starting: root.speedtest-starting;
                speedtest-running: root.speedtest-running;
                speedtest-start => { root.speedtest-start(); }
                loc(key) => { return root.loc(key); }
            }
            if root.connection-overlay-shown : ConnectionOverlay {
                width: parent.width;
                height: parent.height;
                backend-stage: root.backend-stage;
                progress: root.backend-progress;
                backend-ready: root.backend-ready;
                language: root.language;
                startup-stage(language, stage) => { return root.startup-stage(language, stage); }
                loc(key) => { return root.loc(key); }
            }
            if root.dev-page-enabled && root.page-shown(5) : DevPage {
                x: root.page-x(5);
                width: parent.width;
                height: parent.height;
                active: root.page == 5;
                renderer-info: root.renderer-info;
                device-diagnostics: root.device-diagnostics;
                window-size: round(root.width / 1px) + " × " + round(root.height / 1px);
                sample-usage(reset) => { return root.sample-dev-usage(reset); }
                loc(key) => { return root.loc(key); }
            }
        }
        BottomNavigation {
            opacity: root.stage(0.12, 0.55);
            page: root.page;
            connected: !root.connection-overlay-shown;
            dev-page-enabled: root.dev-page-enabled;
            dashboard-editing: root.dashboard-editing;
            battery-percent: root.battery-percent;
            battery-charging: root.battery-charging;
            power-profiles-available: root.power-profiles.length > 0;
            navigate(target) => {
                root.go-to(target);
                if target == 3 && root.connection == "Connected" { root.update-refresh(); }
            }
            toggle-dashboard-editor => { root.toggle-dashboard-editor(); }
            open-wallpaper-picker => { root.dashboard-open-picker("wallpaper"); }
            reset-dashboard => { root.dashboard-editor-reset(); }
            open-power-menu => { root.power-menu-open = true; }
            open-power-details => { root.power-details-open = true; }
            loc(key) => { return root.loc(key); }
        }
    }

    NetworkDrawer {
        width: parent.width;
        height: parent.height;
        network-drawer-open <=> root.network-drawer-open;
        wifi-name <=> root.wifi-name;
        drawer-network-error: root.drawer-network-error;
        drawer-error <=> root.drawer-error;
        wifi-enabled: root.wifi-enabled;
        wifi-available: root.wifi-available;
        bluetooth-available: root.bluetooth-available;
        bluetooth-powered: root.bluetooth-powered;
        bluetooth-scanning: root.bluetooth-scanning;
        bluetooth-busy: root.bluetooth-busy;
        bluetooth-error <=> root.bluetooth-error;
        bluetooth-connected-count: root.bluetooth-connected-count;
        touch-keyboard-open <=> root.touch-keyboard-open;
        drawer-busy: root.drawer-busy;
        wifi: root.wifi;
        ethernet: root.ethernet;
        saved-wifi: root.saved-wifi;
        paired-devices: root.paired-devices;
        discovered-devices: root.discovered-devices;
        commander-url: root.commander-url;
        commander-qr: root.commander-qr;
        wifi-target <=> root.wifi-target;
        wifi-password <=> root.wifi-password;
        dashboard-picker-open: root.dashboard-picker-open;
        gpu-effects: root.gpu-effects;
        fill-text(text, marker, value) => { return root.fill-text(text, marker, value); }
        drawer-command(action, id, password) => { root.drawer-command(action, id, password); }
        loc(key) => { return root.loc(key); }
    }

    if root.page == 1 && root.routing != "" : AudioRoutingDialog {
        width: parent.width;
        height: parent.height;
        audio-interfaces: root.audio-interfaces;
        animated: root.gpu-effects;
        routing: root.routing;
        close => { root.routing = ""; }
        link-output(source, output, linked) => { root.link-output(source, output, linked); }
        per-link-control(source, enabled) => { root.per-link-control(source, enabled); }
        link-volume(source, output, value) => { root.link-volume(source, output, value); }
        loc(key) => { return root.loc(key); }
    }

    if root.dashboard-picker-open : DashboardPicker {
        width: parent.width;
        height: parent.height;
        touch-keyboard-open <=> root.touch-keyboard-open;
        close => { root.dashboard-picker-open = false; }
        wallpaper-picker-loading: root.wallpaper-picker-loading;
        animated: root.gpu-effects;
        keyboard-height: root.keyboard-height;
        dashboard-picker-kind: root.dashboard-picker-kind;
        dashboard-picker-search <=> root.dashboard-picker-search;
        dashboard-picker-items: root.dashboard-picker-items;
        dashboard-filter(query) => { root.dashboard-filter(query); }
        dashboard-select-option(name) => { root.dashboard-select-option(name); }
        dashboard-apply-picker => { root.dashboard-apply-picker(); }
        loc(key) => { return root.loc(key); }
        hide-keyboard => { root.hide-keyboard(); }
    }

    if root.network-drawer-open && root.wifi-target != "" : WifiPasswordDialog {
        width: parent.width;
        height: parent.height;
        wifi-name: root.wifi-name;
        touch-keyboard-open <=> root.touch-keyboard-open;
        drawer-busy: root.drawer-busy;
        wifi-password <=> root.wifi-password;
        animated: root.gpu-effects;
        keyboard-height: root.keyboard-height;
        close-wifi-password => { root.close-wifi-password(); }
        submit-wifi-password => { root.submit-wifi-password(); }
        loc(key) => { return root.loc(key); }
    }

    if (root.dashboard-picker-open || root.wifi-target != "" || root.page == 2) && root.touch-keyboard-open : TouchKeyboard {
        width: parent.width;
        height: root.keyboard-height;
        y: parent.height - self.height;
        touch-keyboard-shift <=> root.touch-keyboard-shift;
        touch-keyboard-symbols <=> root.touch-keyboard-symbols;
        language: root.language;
        keyboard-input(key) => { root.keyboard-input(key); }
        loc(key) => { return root.loc(key); }
        hide-keyboard => { root.hide-keyboard(); }
    }

    if root.osd-visible && root.page != 1 && !root.network-drawer-open && !root.dashboard-editing && !root.touch-keyboard-open : VolumeOsd {
        y: parent.height - self.height - 60px;
        x: (parent.width - self.width) / 2;
        width: min(520px, parent.width);
        height: 58px;
        close => { root.osd-visible = false; }
        osd-item: root.osd-item;
        change-volume(item, value, mute) => { root.change-volume(item, value, mute); }
        loc(key) => { return root.loc(key); }
    }

    if root.power-details-open && !root.power-menu-open : BatteryDialog {
        width: parent.width;
        height: parent.height;
        close => { root.power-details-open = false; }
        animated: root.gpu-effects;
        percent: root.battery-percent;
        battery: root.battery-details;
        history: root.battery-history;
        profiles: root.power-profiles;
        active-profile: root.active-power-profile;
        profile-busy: root.power-profile-busy;
        profile-failed: root.power-profile-failed;
        profile-error: root.power-profile-error;
        choose-profile(profile) => { root.choose-power-profile(profile); }
        loc(key) => { return root.loc(key); }
    }

    if root.power-menu-open : PowerMenu {
        width: parent.width;
        height: parent.height;
        close => { root.power-menu-open = false; }
        animated: root.gpu-effects;
        power-action(action) => { root.power-action(action); }
        loc(key) => { return root.loc(key); }
    }
}
