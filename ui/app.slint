                                                spacing: 8px;
                                                Text { text: "Song requests"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                                                DashboardSwitch { checked: root.music-song-requests; toggled => { root.music-action("songrequest_toggle"); } }
                                            }
                                        }
                                    }
                }
            }
            if root.page == 0 && root.dashboard-editing : VerticalLayout {
                padding: 10px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Edit dashboard"; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    PillButton { width: 170px; label: root.wallpaper-label; clicked => { root.dashboard-open-picker("wallpaper"); } }
                    PillButton { width: 82px; label: "Reset"; clicked => { root.dashboard-editor-reset(); } }
                    PillButton { width: 82px; label: "Cancel"; clicked => { root.dashboard-cancel(); root.dashboard-editing = false; } }
                    PillButton { width: 82px; label: "Save"; selected: true; clicked => { root.dashboard-save(root.edit-left-0, root.edit-left-1, root.edit-right-0, root.edit-right-1); } }
                }
                Text { text: root.feedback; color: Theme.muted; font-size: 11px; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Left column"; color: Theme.text; font-size: 16px; font-weight: 600; }
                            Text { text: "Slot 1"; color: Theme.muted; font-size: 10px; }
                            CardSelector { value: root.edit-left-0; changed(card) => { root.dashboard-open-picker("slot:left-0"); } }
                            Text { text: "Slot 2"; color: Theme.muted; font-size: 10px; }
                            CardSelector { value: root.edit-left-1; changed(card) => { root.dashboard-open-picker("slot:left-1"); } }
                            if root.edit-left-0 == "macros" || root.edit-left-1 == "macros" : VerticalLayout {
                                spacing: 4px;
                                Text { text: "Dashboard macros (max 4)"; font-size: 11px; color: Theme.muted; }
                                PillButton { label: root.dashboard-selected-macros; clicked => { root.dashboard-open-picker("macros"); } }
                            }
                            if root.edit-left-0 == "auto_macros" || root.edit-left-1 == "auto_macros" : VerticalLayout {
                                spacing: 4px;
                                Text { text: "Auto macros (max 4)"; font-size: 11px; color: Theme.muted; }
                                PillButton { label: root.dashboard-selected-auto-macros; clicked => { root.dashboard-open-picker("auto_macros"); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Right column"; color: Theme.text; font-size: 16px; font-weight: 600; }
                            Text { text: "Slot 1"; color: Theme.muted; font-size: 10px; }
                            CardSelector { value: root.edit-right-0; changed(card) => { root.dashboard-open-picker("slot:right-0"); } }
                            Text { text: "Slot 2"; color: Theme.muted; font-size: 10px; }
                            CardSelector { value: root.edit-right-1; changed(card) => { root.dashboard-open-picker("slot:right-1"); } }
                            if root.edit-right-0 == "macros" || root.edit-right-1 == "macros" : VerticalLayout {
                                spacing: 4px;
                                Text { text: "Dashboard macros (max 4)"; font-size: 11px; color: Theme.muted; }
                                PillButton { label: root.dashboard-selected-macros; clicked => { root.dashboard-open-picker("macros"); } }
                            }
                            if root.edit-right-0 == "auto_macros" || root.edit-right-1 == "auto_macros" : VerticalLayout {
                                spacing: 4px;
                                Text { text: "Auto macros (max 4)"; font-size: 11px; color: Theme.muted; }
                                PillButton { label: root.dashboard-selected-auto-macros; clicked => { root.dashboard-open-picker("auto_macros"); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                }
            }
            if root.page == 1 : VerticalLayout {
                padding: 10px;
                spacing: 8px;
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for item[i] in root.audio-interfaces : Rectangle {
                            height: 78px;
                            background: Theme.surface;
                            border-radius: 16px;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 10px;
                                Text { text: item; color: Theme.text; font-size: 15px; horizontal-stretch: 1; vertical-alignment: center; }
                                PillButton { width: 64px; label: "25%"; clicked => { root.change-volume(i, 0.25); } }
                                PillButton { width: 64px; label: "50%"; clicked => { root.change-volume(i, 0.5); } }
                                PillButton { width: 64px; label: "75%"; clicked => { root.change-volume(i, 0.75); } }
                                PillButton { width: 64px; label: "100%"; clicked => { root.change-volume(i, 1.0); } }
                            }
                        }
                    }
                }
            }
            if root.page == 2 : VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    PillButton { width: 132px; label: "Macros"; selected: root.macro-tab == 0; clicked => { root.macro-tab = 0; } }
                    PillButton { width: 132px; label: "Auto Macros"; selected: root.macro-tab == 1; clicked => { root.macro-tab = 1; } }
                    PillButton { width: 160px; label: "Channel Points"; selected: root.macro-tab == 2; clicked => { root.macro-tab = 2; } }
                }
                LineEdit { placeholder-text: "Search"; text <=> root.search; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        if root.macro-tab == 0 : VerticalLayout {
                            spacing: 6px;
                            for item[i] in root.macros : Rectangle {
                                height: 48px;
                                background: Theme.surface;
                                border-radius: 12px;
                                Text { x: 14px; text: item; color: Theme.text; vertical-alignment: center; font-size: 14px; }
                                TouchArea { clicked => { root.trigger-macro(i); } }
                            }
