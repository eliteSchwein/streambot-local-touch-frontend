import { LineEdit, ScrollView } from "std-widgets.slint";

// Original Quickshell Material 3 fallback palette (Md3Theme.qml).
export global Theme {
    out property <color> background: #111318;
    out property <color> surface: #1d2024;
    out property <color> elevated: #282a2f;
    out property <color> raised: #33353a;
    out property <color> primary: #a8c7fa;
    out property <color> on-primary: #062e6f;
    out property <color> text: #e2e2e9;
    out property <color> muted: #c4c6d0;
    out property <color> success: #a8d5a2;
}

export struct InteractionEntry {
    name: string,
    meta: string,
    uuid: string,
    active: bool,
    failed: bool,
    progress: float,
}

export struct AutoMacroEntry {
    name: string,
    enabled: bool,
    progress: float,
}

component DashboardSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: checked ? Theme.primary : Theme.raised;
    border-width: checked ? 0px : 2px;
    border-color: Theme.muted;
    Rectangle {
        width: root.checked ? 24px : 16px;
        height: root.checked ? 24px : 16px;
        x: root.checked ? 24px : 6px;
        y: (parent.height - self.height) / 2;
        background: root.checked ? Theme.on-primary : Theme.muted;
        border-radius: self.width / 2;
    }
    TouchArea { clicked => { root.toggled(); } }
}

component MusicIconButton inherits Rectangle {
    in property <string> glyph: "";
    in property <bool> filled: false;
    in property <bool> selected: false;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: filled ? Theme.primary : (selected ? Theme.elevated : transparent);
    Text {
        text: root.glyph;
        color: root.filled ? Theme.on-primary : Theme.text;
        font-size: 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component PillButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: selected ? Theme.primary : Theme.elevated;
    Text {
        text: root.label;
        color: root.selected ? Theme.on-primary : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Key caps match the original Md3Keyboard (8px radius, small gaps, pressed state).
component TouchKey inherits Rectangle {
    in property <string> label: "";
    in property <bool> accent: false;
    callback clicked();
    height: 42px;
    border-radius: 8px;
    background: touch.pressed ? Theme.primary : (accent ? Theme.elevated : Theme.raised);
    Text {
        text: root.label;
        color: touch.pressed ? Theme.on-primary : Theme.text;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component CardSelector inherits Rectangle {
    in-out property <string> value: "";
    callback changed(string);
    height: 42px;
    background: Theme.elevated;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.raised;
    Text {
        x: 12px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.value == "" ? "Empty" : root.value == "auto_macros" ? "Auto Macros" : root.value == "interactions" ? "Interactions" : root.value == "macros" ? "Macros" : "Music";
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text { text: "▼"; height: parent.height; x: parent.width - 25px; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
    TouchArea { clicked => { root.changed("open"); } }
}

export struct PickerEntry {
    name: string,
    selected: bool,
    thumbnail: image,
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <image> active-icon;
    in property <bool> active: false;
    callback clicked();
    width: 72px;
    height: 42px;
    background: transparent;
    Rectangle {
        width: 56px;
        height: 32px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: root.active ? Theme.primary : transparent;
        Image {
            width: 21px;
            height: 21px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.active ? root.active-icon : root.icon;
            image-fit: contain;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}


export component App inherits Window {
    title: "Streambot Touch";
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 700px;
    min-height: 450px;
    background: Theme.background;

    in-out property <int> page: 0;
    in-out property <string> connection: "Waiting for backend";
    in-out property <string> backend-stage: "";
    in-out property <string> detail: "";
    in-out property <string> track: "No track information";
    in-out property <string> music-state: "";
    in-out property <string> interaction-summary: "No interactions";
    in-out property <string> system-summary: "No system statistics yet";
    in-out property <string> storage-summary: "No storage information yet";
    in-out property <string> speedtest-summary: "Not run";
    in-out property <string> update-summary: "No update information yet";
    in-out property <[string]> macros: [];
    in-out property <[string]> auto-macros: [];
    in-out property <[string]> channel-points: [];
    in-out property <[string]> audio-interfaces: [];
    in-out property <string> search: "";
    in-out property <int> macro-tab: 0;
    in-out property <string> feedback: "";
    in-out property <bool> dashboard-editing: false;
    in-out property <string> left-slot-0: "interactions";
    in-out property <string> left-slot-1: "auto_macros";
    in-out property <string> right-slot-0: "music";
    in-out property <string> right-slot-1: "";
    in-out property <string> edit-left-0: "interactions";
    in-out property <string> edit-left-1: "auto_macros";
    in-out property <string> edit-right-0: "music";
    in-out property <string> edit-right-1: "";
    in-out property <bool> power-menu-open: false;
    in-out property <bool> network-drawer-open: false;
    in-out property <bool> drawer-swipe-armed: false;
    in-out property <string> drawer-network: "Checking network...";
    in-out property <string> drawer-bluetooth: "Checking Bluetooth...";
    in-out property <bool> touch-keyboard-open: false;
    in-out property <bool> touch-keyboard-shift: false;
    in-out property <bool> touch-keyboard-symbols: false;
    callback refresh-drawer();
    callback drawer-command(string);
    callback keyboard-input(string);
    callback dashboard-save(string, string, string, string);
    callback dashboard-cancel();
    callback power-action(string);
    in-out property <bool> dashboard-picker-open: false;
    in-out property <string> dashboard-picker-kind: "";
    in-out property <string> dashboard-picker-search: "";
    in-out property <[PickerEntry]> dashboard-picker-items: [];
    in-out property <string> dashboard-selected-macros: "None selected";
    in-out property <string> dashboard-selected-auto-macros: "None selected";
    in-out property <image> wallpaper-image;
    in-out property <string> wallpaper-label: "No wallpaper";
    in-out property <[string]> dashboard-macro-list: [];
    callback dashboard-open-picker(string);
    callback dashboard-filter(string);
    callback dashboard-select-option(string);
    callback dashboard-apply-picker();
    callback dashboard-editor-open();
    callback dashboard-editor-reset();


    in-out property <bool> show-dashboard-macros: false;
    in-out property <[InteractionEntry]> dashboard-interactions: [];
    in-out property <[AutoMacroEntry]> dashboard-auto-macros: [];
    in-out property <string> music-title: "No song";
    in-out property <string> music-artist: "Unknown artist";
    in-out property <bool> music-playing: false;
    in-out property <bool> music-shuffle: false;
    in-out property <bool> music-loop: false;
    in-out property <bool> music-song-requests: false;
    in-out property <float> music-progress: 0;
    in-out property <string> music-position: "0:00";
    in-out property <string> music-duration: "0:00";
    in-out property <[float]> cava-bars: [0, 0, 0, 0, 0];

    callback remove-interaction(string);
    callback trigger-macro(int);
    callback trigger-dashboard-macro(string);
    callback toggle-dashboard-auto-macro(string);
    callback toggle-auto-macro(int);
    callback toggle-channel-point(int);
    callback music-action(string);
    callback speedtest-start();
    callback update-refresh();
    callback change-volume(int, float);

    Image {
        width: parent.width;
        height: parent.height;
        source: root.wallpaper-image;
        image-fit: cover;
    }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            // Quickshell's content area ends directly above the bottom navigation.
            // DashboardPage.qml: 10px margins, 8px columns, no card headings.
            if root.page == 0 && !root.dashboard-editing : HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                VerticalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    if root.left-slot-0 == "interactions" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 5px;
                                                if root.dashboard-interactions.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No interactions";
                                                        color: Theme.muted;
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.dashboard-interactions.length > 0 : ScrollView {
                                                    vertical-stretch: 1;
                                                    VerticalLayout {
                                                        spacing: 5px;
                                                        for item[i] in root.dashboard-interactions : Rectangle {
                                                            height: 50px;
                                                            border-radius: 12px;
                                                            background: item.active ? Theme.elevated : Theme.raised;
                                                            Rectangle {
                                                                height: 3px;
                                                                y: parent.height - self.height;
                                                                x: 0px;
                                                                width: parent.width * max(0, min(1, item.progress));
                                                                border-radius: 2px;
                                                                background: Theme.success;
                                                                visible: item.active;
                                                            }
                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 6px;
                                                                spacing: 8px;
                                                                Rectangle {
                                                                    width: 8px;
                                                                    height: 8px;
                                                                    border-radius: 4px;
                                                                    background: item.active ? Theme.success : (item.failed ? #ffb4ab : #8e9099);
                                                                }
                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    spacing: 1px;
                                                                    Text { text: item.name; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                                                                    Text { text: item.meta; color: item.failed ? #ffb4ab : Theme.muted; font-size: 8px; overflow: elide; }
                                                                    if item.uuid != "" : Text { text: item.uuid; color: #8e9099; font-size: 7px; overflow: elide; }
                                                                }
                                                                MusicIconButton { width: 34px; height: 34px; glyph: "×"; clicked => { root.remove-interaction(item.uuid); } }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                    if root.left-slot-0 == "auto_macros" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                if root.dashboard-auto-macros.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No auto macros";
                                                        color: Theme.muted;
                                                        font-size: 10px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                for item[i] in root.dashboard-auto-macros : Rectangle {
                                                    vertical-stretch: 1;
                                                    border-radius: 12px;
                                                    background: Theme.raised;
                                                    Rectangle {
                                                        x: 0px;
                                                        width: parent.width * max(0, min(1, item.progress));
                                                        height: parent.height;
                                                        border-radius: 12px;
                                                        background: Theme.elevated;
                                                        visible: item.enabled;
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 6px;
                                                        spacing: 6px;
                                                        Text {
                                                            text: item.name;
                                                            horizontal-stretch: 1;
                                                            color: Theme.text;
                                                            font-size: 11px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }
                                                        DashboardSwitch { checked: item.enabled; toggled => { root.toggle-dashboard-auto-macro(item.name); } }
                                                    }
                                                }
                                            }
                                        }
                    if root.left-slot-0 == "macros" : Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            if root.dashboard-macro-list.length == 0 : Text { text: "No macros"; color: Theme.muted; font-size: 12px; }
                            for item[i] in root.dashboard-macro-list : Rectangle {
                                vertical-stretch: 1;
                                background: Theme.raised;
                                border-radius: 12px;
                                Text { text: item; x: 12px; color: Theme.text; vertical-alignment: center; font-size: 12px; }
                                TouchArea { clicked => { root.trigger-dashboard-macro(item); } }
                            }
                        }
                    }
                    if root.left-slot-0 == "music" : Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.surface;
                                        border-radius: 16px;
                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text { text: root.music-title; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                                Text { text: root.music-artist; color: Theme.muted; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                            }
                                            // Fixed-size CAVA region. Audio levels only change bar geometry,
                                            // never the Music card's preferred size or layout stretch.
                                            Rectangle {
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    height: 110px;
                                                    width: 106px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: parent.height - self.height;
                                                    background: transparent;
                                                    for level[i] in root.cava-bars : Rectangle {
                                                        width: 14px;
                                                        x: i * 23px;
                                                        height: max(6px, min(110px, level * 1.1px));
                                                        y: parent.height - self.height;
                                                        background: Theme.primary;
                                                        border-radius: 7px;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 12px;
                                                MusicIconButton { glyph: "⤨"; selected: root.music-shuffle; clicked => { root.music-action("shuffle"); } }
                                                MusicIconButton { glyph: "◀"; clicked => { root.music-action("back"); } }
                                                MusicIconButton { glyph: root.music-playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.music-action(root.music-playing ? "pause" : "play"); } }
                                                MusicIconButton { glyph: "▶"; clicked => { root.music-action("next"); } }
                                                MusicIconButton { glyph: "↻"; selected: root.music-loop; clicked => { root.music-action("loop"); } }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Rectangle {
                                                    height: 7px;
                                                    background: Theme.raised;
                                                    border-radius: 4px;
                                                    Rectangle { height: parent.height; x: 0px; width: parent.width * max(0, min(100, root.music-progress)) / 100; background: Theme.primary; border-radius: 4px; }
                                                }
                                                HorizontalLayout {
                                                    Text { text: root.music-position; font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                                    Text { text: root.music-duration; font-size: 10px; color: Theme.muted; }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Text { text: "Song requests"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                                                DashboardSwitch { checked: root.music-song-requests; toggled => { root.music-action("songrequest_toggle"); } }
                                            }
                                        }
                                    }
                    if root.left-slot-1 == "interactions" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 5px;
                                                if root.dashboard-interactions.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No interactions";
                                                        color: Theme.muted;
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.dashboard-interactions.length > 0 : ScrollView {
                                                    vertical-stretch: 1;
                                                    VerticalLayout {
                                                        spacing: 5px;
                                                        for item[i] in root.dashboard-interactions : Rectangle {
                                                            height: 50px;
                                                            border-radius: 12px;
                                                            background: item.active ? Theme.elevated : Theme.raised;
                                                            Rectangle {
                                                                height: 3px;
                                                                y: parent.height - self.height;
                                                                x: 0px;
                                                                width: parent.width * max(0, min(1, item.progress));
                                                                border-radius: 2px;
                                                                background: Theme.success;
                                                                visible: item.active;
                                                            }
                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 6px;
                                                                spacing: 8px;
                                                                Rectangle {
                                                                    width: 8px;
                                                                    height: 8px;
                                                                    border-radius: 4px;
                                                                    background: item.active ? Theme.success : (item.failed ? #ffb4ab : #8e9099);
                                                                }
                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    spacing: 1px;
                                                                    Text { text: item.name; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                                                                    Text { text: item.meta; color: item.failed ? #ffb4ab : Theme.muted; font-size: 8px; overflow: elide; }
                                                                    if item.uuid != "" : Text { text: item.uuid; color: #8e9099; font-size: 7px; overflow: elide; }
                                                                }
                                                                MusicIconButton { width: 34px; height: 34px; glyph: "×"; clicked => { root.remove-interaction(item.uuid); } }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                    if root.left-slot-1 == "auto_macros" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                if root.dashboard-auto-macros.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No auto macros";
                                                        color: Theme.muted;
                                                        font-size: 10px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                for item[i] in root.dashboard-auto-macros : Rectangle {
                                                    vertical-stretch: 1;
                                                    border-radius: 12px;
                                                    background: Theme.raised;
                                                    Rectangle {
                                                        x: 0px;
                                                        width: parent.width * max(0, min(1, item.progress));
                                                        height: parent.height;
                                                        border-radius: 12px;
                                                        background: Theme.elevated;
                                                        visible: item.enabled;
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 6px;
                                                        spacing: 6px;
                                                        Text {
                                                            text: item.name;
                                                            horizontal-stretch: 1;
                                                            color: Theme.text;
                                                            font-size: 11px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }
                                                        DashboardSwitch { checked: item.enabled; toggled => { root.toggle-dashboard-auto-macro(item.name); } }
                                                    }
                                                }
                                            }
                                        }
                    if root.left-slot-1 == "macros" : Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            if root.dashboard-macro-list.length == 0 : Text { text: "No macros"; color: Theme.muted; font-size: 12px; }
                            for item[i] in root.dashboard-macro-list : Rectangle {
                                vertical-stretch: 1;
                                background: Theme.raised;
                                border-radius: 12px;
                                Text { text: item; x: 12px; color: Theme.text; vertical-alignment: center; font-size: 12px; }
                                TouchArea { clicked => { root.trigger-dashboard-macro(item); } }
                            }
                        }
                    }
                    if root.left-slot-1 == "music" : Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.surface;
                                        border-radius: 16px;
                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text { text: root.music-title; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                                Text { text: root.music-artist; color: Theme.muted; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                            }
                                            // Fixed-size CAVA region. Audio levels only change bar geometry,
                                            // never the Music card's preferred size or layout stretch.
                                            Rectangle {
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    height: 110px;
                                                    width: 106px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: parent.height - self.height;
                                                    background: transparent;
                                                    for level[i] in root.cava-bars : Rectangle {
                                                        width: 14px;
                                                        x: i * 23px;
                                                        height: max(6px, min(110px, level * 1.1px));
                                                        y: parent.height - self.height;
                                                        background: Theme.primary;
                                                        border-radius: 7px;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 12px;
                                                MusicIconButton { glyph: "⤨"; selected: root.music-shuffle; clicked => { root.music-action("shuffle"); } }
                                                MusicIconButton { glyph: "◀"; clicked => { root.music-action("back"); } }
                                                MusicIconButton { glyph: root.music-playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.music-action(root.music-playing ? "pause" : "play"); } }
                                                MusicIconButton { glyph: "▶"; clicked => { root.music-action("next"); } }
                                                MusicIconButton { glyph: "↻"; selected: root.music-loop; clicked => { root.music-action("loop"); } }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Rectangle {
                                                    height: 7px;
                                                    background: Theme.raised;
                                                    border-radius: 4px;
                                                    Rectangle { height: parent.height; x: 0px; width: parent.width * max(0, min(100, root.music-progress)) / 100; background: Theme.primary; border-radius: 4px; }
                                                }
                                                HorizontalLayout {
                                                    Text { text: root.music-position; font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                                    Text { text: root.music-duration; font-size: 10px; color: Theme.muted; }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Text { text: "Song requests"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                                                DashboardSwitch { checked: root.music-song-requests; toggled => { root.music-action("songrequest_toggle"); } }
                                            }
                                        }
                                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    if root.right-slot-0 == "interactions" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 5px;
                                                if root.dashboard-interactions.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No interactions";
                                                        color: Theme.muted;
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.dashboard-interactions.length > 0 : ScrollView {
                                                    vertical-stretch: 1;
                                                    VerticalLayout {
                                                        spacing: 5px;
                                                        for item[i] in root.dashboard-interactions : Rectangle {
                                                            height: 50px;
                                                            border-radius: 12px;
                                                            background: item.active ? Theme.elevated : Theme.raised;
                                                            Rectangle {
                                                                height: 3px;
                                                                y: parent.height - self.height;
                                                                x: 0px;
                                                                width: parent.width * max(0, min(1, item.progress));
                                                                border-radius: 2px;
                                                                background: Theme.success;
                                                                visible: item.active;
                                                            }
                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 6px;
                                                                spacing: 8px;
                                                                Rectangle {
                                                                    width: 8px;
                                                                    height: 8px;
                                                                    border-radius: 4px;
                                                                    background: item.active ? Theme.success : (item.failed ? #ffb4ab : #8e9099);
                                                                }
                                                                VerticalLayout {
                                                                    horizontal-stretch: 1;
                                                                    spacing: 1px;
                                                                    Text { text: item.name; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                                                                    Text { text: item.meta; color: item.failed ? #ffb4ab : Theme.muted; font-size: 8px; overflow: elide; }
                                                                    if item.uuid != "" : Text { text: item.uuid; color: #8e9099; font-size: 7px; overflow: elide; }
                                                                }
                                                                MusicIconButton { width: 34px; height: 34px; glyph: "×"; clicked => { root.remove-interaction(item.uuid); } }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                    if root.right-slot-0 == "auto_macros" : Rectangle {
                                            vertical-stretch: 1;
                                            background: Theme.surface;
                                            border-radius: 16px;
                                            VerticalLayout {
                                                padding: 14px;
                                                spacing: 4px;
                                                if root.dashboard-auto-macros.length == 0 : Rectangle {
                                                    vertical-stretch: 1;
                                                    background: transparent;
                                                    Text {
                                                        text: "No auto macros";
                                                        color: Theme.muted;
                                                        font-size: 10px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                for item[i] in root.dashboard-auto-macros : Rectangle {
                                                    vertical-stretch: 1;
                                                    border-radius: 12px;
                                                    background: Theme.raised;
                                                    Rectangle {
                                                        x: 0px;
                                                        width: parent.width * max(0, min(1, item.progress));
                                                        height: parent.height;
                                                        border-radius: 12px;
                                                        background: Theme.elevated;
                                                        visible: item.enabled;
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 6px;
                                                        spacing: 6px;
                                                        Text {
                                                            text: item.name;
                                                            horizontal-stretch: 1;
                                                            color: Theme.text;
                                                            font-size: 11px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }
                                                        DashboardSwitch { checked: item.enabled; toggled => { root.toggle-dashboard-auto-macro(item.name); } }
                                                    }
                                                }
                                            }
                                        }
                    if root.right-slot-0 == "macros" : Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            if root.dashboard-macro-list.length == 0 : Text { text: "No macros"; color: Theme.muted; font-size: 12px; }
                            for item[i] in root.dashboard-macro-list : Rectangle {
                                vertical-stretch: 1;
                                background: Theme.raised;
                                border-radius: 12px;
                                Text { text: item; x: 12px; color: Theme.text; vertical-alignment: center; font-size: 12px; }
                                TouchArea { clicked => { root.trigger-dashboard-macro(item); } }
                            }
                        }
                    }
                    if root.right-slot-0 == "music" : Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.surface;
                                        border-radius: 16px;
                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text { text: root.music-title; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                                Text { text: root.music-artist; color: Theme.muted; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                            }
                                            // Fixed-size CAVA region. Audio levels only change bar geometry,
                                            // never the Music card's preferred size or layout stretch.
                                            Rectangle {
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    height: 110px;
                                                    width: 106px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: parent.height - self.height;
                                                    background: transparent;
                                                    for level[i] in root.cava-bars : Rectangle {
                                                        width: 14px;
                                                        x: i * 23px;
                                                        height: max(6px, min(110px, level * 1.1px));
                                                        y: parent.height - self.height;
                                                        background: Theme.primary;
                                                        border-radius: 7px;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 12px;
                                                MusicIconButton { glyph: "⤨"; selected: root.music-shuffle; clicked => { root.music-action("shuffle"); } }
                                                MusicIconButton { glyph: "◀"; clicked => { root.music-action("back"); } }
                                                MusicIconButton { glyph: root.music-playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.music-action(root.music-playing ? "pause" : "play"); } }
                                                MusicIconButton { glyph: "▶"; clicked => { root.music-action("next"); } }
                                                MusicIconButton { glyph: "↻"; selected: root.music-loop; clicked => { root.music-action("loop"); } }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Rectangle {
                                                    height: 7px;
                                                    background: Theme.raised;
                                                    border-radius: 4px;
                                                    Rectangle { height: parent.height; x: 0px; width: parent.width * max(0, min(100, root.music-progress)) / 100; background: Theme.primary; border-radius: 4px; }
                                                }
                                                HorizontalLayout {
                                                    Text { text: root.music-position; font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                                    Text { text: root.music-duration; font-size: 10px; color: Theme.muted; }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Text { text: "Song requests"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
                                                DashboardSwitch { checked: root.music-song-requests; toggled => { root.music-action("songrequest_toggle"); } }
                                            }
                                        }
