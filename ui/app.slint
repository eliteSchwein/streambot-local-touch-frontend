                                                    background: transparent;
                                                    Text {
                                                        text: "No auto macros";
                                                        color: Theme.muted;
                                                        font-size: 10px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                for item[i] in root.dashboard-auto-macros : Rectangle {
                                                    vertical-stretch: 1;
                                                    border-radius: 12px;
                                                    background: Theme.raised;
                                                    Rectangle {
                                                        x: 0px;
                                                        width: parent.width * max(0, min(1, item.progress));
                                                        height: parent.height;
                                                        border-radius: 12px;
                                                        background: Theme.elevated;
                                                        visible: item.enabled;
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 6px;
                                                        spacing: 6px;
                                                        Text {
                                                            text: item.name;
                                                            horizontal-stretch: 1;
                                                            color: Theme.text;
                                                            font-size: 11px;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }
                                                        DashboardSwitch { checked: item.enabled; toggled => { root.toggle-dashboard-auto-macro(item.name); } }
                                                    }
                                                }
                                            }
                                        }
                    if root.right-slot-1 == "macros" : Rectangle {
                        vertical-stretch: 1;
                        background: Theme.surface;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            if root.dashboard-macro-list.length == 0 : Text { text: "No macros"; color: Theme.muted; font-size: 12px; }
                            for item[i] in root.dashboard-macro-list : Rectangle {
                                vertical-stretch: 1;
