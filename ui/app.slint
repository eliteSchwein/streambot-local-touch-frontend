                    }
                    if root.right-slot-1 == "music" : Rectangle {
                                        horizontal-stretch: 1;
                                        background: Theme.surface;
                                        border-radius: 16px;
                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text { text: root.music-title; color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                                Text { text: root.music-artist; color: Theme.muted; font-size: 12px; horizontal-alignment: center; overflow: elide; }
                                            }
                                            // Fixed-size CAVA region. Audio levels only change bar geometry,
                                            // never the Music card's preferred size or layout stretch.
                                            Rectangle {
                                                vertical-stretch: 1;
                                                background: transparent;
                                                Rectangle {
                                                    height: 110px;
                                                    width: 106px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: parent.height - self.height;
                                                    background: transparent;
                                                    for level[i] in root.cava-bars : Rectangle {
                                                        width: 14px;
                                                        x: i * 23px;
                                                        height: max(6px, min(110px, level * 1.1px));
                                                        y: parent.height - self.height;
                                                        background: Theme.primary;
                                                        border-radius: 7px;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 12px;
                                                MusicIconButton { glyph: "⤨"; selected: root.music-shuffle; clicked => { root.music-action("shuffle"); } }
                                                MusicIconButton { glyph: "◀"; clicked => { root.music-action("back"); } }
                                                MusicIconButton { glyph: root.music-playing ? "Ⅱ" : "▶"; filled: true; clicked => { root.music-action(root.music-playing ? "pause" : "play"); } }
                                                MusicIconButton { glyph: "▶"; clicked => { root.music-action("next"); } }
                                                MusicIconButton { glyph: "↻"; selected: root.music-loop; clicked => { root.music-action("loop"); } }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Rectangle {
                                                    height: 7px;
                                                    background: Theme.raised;
                                                    border-radius: 4px;
                                                    Rectangle { height: parent.height; x: 0px; width: parent.width * max(0, min(100, root.music-progress)) / 100; background: Theme.primary; border-radius: 4px; }
                                                }
                                                HorizontalLayout {
                                                    Text { text: root.music-position; font-size: 10px; color: Theme.muted; horizontal-stretch: 1; }
                                                    Text { text: root.music-duration; font-size: 10px; color: Theme.muted; }
                                                }
