import { Theme } from "../theme.slint";
import { NavItem, PillButton } from "common.slint";

export component ConnectionOverlay inherits Rectangle {
    in property <string> backend-stage;
    in property <float> progress;
    in property <bool> backend-ready;
    in property <string> language;
    pure callback startup-stage(string, string) -> string;
    pure callback loc(string) -> string;

    background: Theme.background;
    TouchArea {}
    VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: root.loc(root.backend-ready ? "connect_connection_lost" : "connect_starting_title");
            color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center;
        }
        Text {
            text: root.loc(root.backend-ready ? "connect_connection_lost_text" : "connect_starting_text");
            color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap;
        }
        Text {
            text: root.backend-ready ? root.loc("connect_reconnecting") : root.startup-stage(root.language, root.backend-stage);
            color: Theme.primary; font-size: 12px; horizontal-alignment: center;
        }
        if !root.backend-ready : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(280px, root.width * 0.6);
                height: 6px;
                border-radius: 3px;
                background: Theme.raised;
                accessible-role: progress-indicator;
                accessible-label: root.loc("connect_starting_title");
                accessible-value: root.progress;
                accessible-value-minimum: 0.0;
                accessible-value-maximum: 1.0;
                if root.progress > 0 : Rectangle {
                    x: 0px;
                    width: parent.width * clamp(root.progress, 0, 1);
                    height: parent.height;
                    border-radius: 3px;
                    background: Theme.primary;
                }
            }
        }
    }
}

export component BottomNavigation inherits Rectangle {
    in property <int> page;
    in property <bool> connected;
    in property <bool> dev-page-enabled;
    in property <bool> dashboard-editing;
    in property <int> battery-percent: -1;
    in property <bool> battery-charging;
    in property <bool> power-profiles-available;
    callback navigate(int);
    callback toggle-dashboard-editor();
    callback open-wallpaper-picker();
    callback reset-dashboard();
    callback open-power-menu();
    callback open-power-details();
    pure callback loc(string) -> string;

    property <bool> show-power-details: root.battery-percent >= 0 || root.power-profiles-available;
    property <length> side-margin: 10px;
    // Without a battery only the plug icon is shown, so the slot shrinks to keep the edit pen close.
    property <length> battery-width: root.battery-percent >= 0 ? 80px : 22px;
    property <length> edit-width: 40px;
    property <length> edit-x: root.side-margin + (root.show-power-details ? root.battery-width + 4px : 0px);
    property <int> page-count: root.dev-page-enabled ? 6 : 5;
    property <length> page-spacing: 10px;
    // Reserve equal space on both sides so the page buttons stay centered at narrow widths.
    property <length> page-button-width: clamp(
        (root.width - 2 * (root.edit-x + root.edit-width + 8px) - (root.page-count - 1) * root.page-spacing) / root.page-count,
        0px, 72px);

    height: 52px;
    background: Theme.surface;
    if root.dashboard-editing : HorizontalLayout {
        width: self.preferred-width;
        height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        spacing: 10px;
        PillButton {
            label: root.loc("dashboard_wallpaper");
            clicked => { root.open-wallpaper-picker(); }
        }
        PillButton { label: root.loc("dashboard_reset"); clicked => { root.reset-dashboard(); } }
    }
    if !root.dashboard-editing : HorizontalLayout {
        width: self.preferred-width;
        height: 42px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        spacing: root.page-spacing;
        NavItem { width: root.page-button-width; label: root.loc("page_home"); icon: @image-url("../icons/mdi/home.svg"); active-icon: @image-url("../icons/mdi-selected/home.svg"); active: root.page == 0; clicked => { root.navigate(0); } }
        NavItem { width: root.page-button-width; label: root.loc("audio"); icon: @image-url("../icons/mdi/volume-high.svg"); active-icon: @image-url("../icons/mdi-selected/volume-high.svg"); active: root.page == 1; clicked => { root.navigate(1); } }
        NavItem { width: root.page-button-width; label: root.loc("page_controls"); icon: @image-url("../icons/mdi/tune.svg"); active-icon: @image-url("../icons/mdi-selected/tune.svg"); active: root.page == 2; clicked => { root.navigate(2); } }
        NavItem { width: root.page-button-width; label: root.loc("page_system"); icon: @image-url("../icons/mdi/server.svg"); active-icon: @image-url("../icons/mdi-selected/server.svg"); active: root.page == 3; clicked => { root.navigate(3); } }
        NavItem { width: root.page-button-width; label: root.loc("page_speedtest"); icon: @image-url("../icons/mdi/speedometer.svg"); active-icon: @image-url("../icons/mdi-selected/speedometer.svg"); active: root.page == 4; clicked => { root.navigate(4); } }
        if root.dev-page-enabled : NavItem {
            width: root.page-button-width;
            label: root.loc("page_dev");
            icon: @image-url("../icons/mdi/code-tags.svg");
            active-icon: @image-url("../icons/mdi-selected/code-tags.svg");
            active: root.page == 5;
            clicked => { root.navigate(5); }
        }
    }
    if root.page == 0 && (root.connected || root.dashboard-editing) : Rectangle {
        width: root.edit-width;
        height: 40px;
        x: root.edit-x;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: root.dashboard-editing ? Theme.primary : transparent;
        Text {
            text: root.dashboard-editing ? "✓" : "✎";
            color: root.dashboard-editing ? Theme.on-primary : Theme.muted;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.toggle-dashboard-editor(); } }
    }
    if root.show-power-details : Rectangle {
        width: root.battery-width;
        height: 40px;
        x: root.side-margin;
        y: (parent.height - self.height) / 2;
        accessible-role: button;
        accessible-label: root.battery-percent < 0 ? root.loc("power_profiles")
            : root.loc("battery") + " " + root.battery-percent + "%"
                + (root.battery-charging ? " · " + root.loc("battery_charging") : "");
        accessible-action-default => { root.open-power-details(); }
        // No battery: show a power plug (MDI "power-plug") instead of a text label.
        if root.battery-percent < 0 : Path {
            // Viewbox cropped to the glyph bounds so it sits flush left.
            width: 14px;
            height: 21px;
            // Left gap to the bar edge matches the bottom gap.
            x: (root.height - self.height) / 2 - root.side-margin;
            y: (parent.height - self.height) / 2;
            viewbox-x: 6;
            viewbox-y: 3;
            viewbox-width: 12;
            viewbox-height: 18;
            commands: "M16,7V3H14V7H10V3H8V7C7,7 6,8 6,9V14.5L9.5,18V21H14.5V18L18,14.5V9C18,8 17,7 16,7Z";
            fill: Theme.text;
        }
        if root.battery-percent >= 0 : HorizontalLayout {
            spacing: 5px;
            alignment: center;
            Rectangle {
                width: 27px;
                Rectangle {
                    width: 24px;
                    height: 14px;
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: root.battery-charging ? Theme.primary : Theme.muted;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: (parent.width - 4px) * clamp(root.battery-percent, 0, 100) / 100;
                        height: parent.height - 4px;
                        border-radius: 1px;
                        background: root.battery-charging ? Theme.primary.with-alpha(0.22) : Theme.text;
                    }
                    if root.battery-charging : Path {
                        width: 10px;
                        height: 12px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 10;
                        viewbox-height: 14;
                        commands: "M 6.5 0 L 0 8.5 H 4 L 3.5 14 L 10 5.5 H 6 Z";
                        fill: Theme.primary;
                    }
                }
                Rectangle {
                    x: 24px;
                    width: 2px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1px;
                    background: root.battery-charging ? Theme.primary : Theme.muted;
                }
            }
            Text {
                text: root.battery-percent + "%";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        TouchArea { clicked => { root.open-power-details(); } }
    }
    Rectangle {
        width: 40px;
        height: 40px;
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        Image { width: 21px; height: 21px; source: @image-url("../icons/mdi/power.svg"); }
        TouchArea { clicked => { root.open-power-menu(); } }
    }
}
